// Проверяет цену строки чека по ценам из марки: не ниже минимальной и ровно МРЦ.
// Нулевую цену не проверяет: такую строку типовая сама удаляет или просит кассира ввести цену.
//
// Параметры:
//  Цена - Число - цена строки чека.
//  МРЦ - Число, Неопределено - МРЦ из марки.
//  МинимальнаяЦена - Число, Неопределено - минимальная цена из марки.
//  Номенклатура - СправочникСсылка.Номенклатура - для текста запрета.
//
// Возвращаемое значение:
//  Строка - текст запрета продажи; пустая, если цена допустима.
//
Функция ТекстОшибкиЦены(Цена, МРЦ, МинимальнаяЦена, Номенклатура) Экспорт

	Если Цена = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(МинимальнаяЦена) И Цена < МинимальнаяЦена Тогда
		Возврат СтрШаблон(НСтр("ru = 'Цена %1 ниже минимальной %2: %3.'"),
			Цена, МинимальнаяЦена, Номенклатура);
	КонецЕсли;

	Если ЗначениеЗаполнено(МРЦ) И Цена <> МРЦ Тогда
		Возврат СтрШаблон(НСтр("ru = 'Цена %1 не равна МРЦ %2: %3.'"),
			Цена, МРЦ, Номенклатура);
	КонецЕсли;

	Возврат "";

КонецФункции
