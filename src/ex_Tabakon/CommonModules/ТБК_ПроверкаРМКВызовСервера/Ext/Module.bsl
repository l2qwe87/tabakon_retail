// Проверяет цену строки чека по ценам из марки: не ниже минимальной и ровно МРЦ.
// Нулевую цену не проверяет: такую строку типовая сама удаляет или просит кассира ввести цену.
//
// Параметры:
//  Цена - Число - цена строки чека.
//  МРЦ - Число, Неопределено - МРЦ единицы строки, подготовленная типовым кодом.
//  МинимальнаяЦена - Число, Неопределено - минимальная цена базовой единицы из данных марки.
//  Номенклатура - СправочникСсылка.Номенклатура - для текста запрета.
//  Упаковка - СправочникСсылка.УпаковкиНоменклатуры, Неопределено - упаковка строки;
//             пустое значение означает базовую единицу с коэффициентом 1.
//
// Возвращаемое значение:
//  Строка - текст запрета продажи; пустая, если цена допустима.
//
Функция ТекстОшибкиЦены(Знач Цена, Знач МРЦ, Знач МинимальнаяЦена, Знач Номенклатура, Знач Упаковка) Экспорт

	Если Цена = 0 Тогда
		Возврат "";
	КонецЕсли;

	Коэффициент = 1;
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Упаковка, "Коэффициент");
		Если Коэффициент <= 0 Тогда
			Возврат СтрШаблон(НСтр("ru = 'Не задан коэффициент упаковки: %1.'"), Номенклатура);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(МинимальнаяЦена) Тогда
		//МинимальнаяЦена = Коэффициент * МинимальнаяЦена; 
		Если  Цена < МинимальнаяЦена Тогда
			Возврат СтрШаблон(НСтр("ru = 'Цена %1 ниже минимальной %2: %3.'"),
			Цена, МинимальнаяЦена, Номенклатура);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(МРЦ) Тогда
		Если Цена <> МРЦ Тогда
			Возврат СтрШаблон(НСтр("ru = 'Цена %1 не равна МРЦ %2: %3.'"),
			Цена, МРЦ, Номенклатура);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";

КонецФункции

// Подбирает характеристики табачных марок до сохранения элементов и добавления товаров в документ.
// Проверяет весь набор; при отказе характеристики успешных строк также не применяются.
//
// Параметры:
//  ДанныеПоШтрихкодам - См. ШтрихкодированиеОбщегоНазначенияИС.ИнициализацияДанныхПоШтрихкодам.
//
// Возвращаемое значение:
//  Булево - Истина, если подбор выполнен; Ложь, если продажа запрещена с диагностикой в данных.
//
Функция ЗаполнитьХарактеристикиПоМРЦ(ДанныеПоШтрихкодам) Экспорт

	СтрокиПодбора = Новый Массив;
	Номенклатура = Новый Массив;
	Упаковки = Новый Массив;
	Для Каждого СтрокаДанных Из ДанныеПоШтрихкодам.ДанныеКодовМаркировки Цикл
		Если СтрокаДанных.ОбработанСОшибками
			Или Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияМОТП(СтрокаДанных.ВидПродукции)
			Или СтрокаДанных.ЭтоШтрихкодНоменклатуры
			Или Не ЗначениеЗаполнено(СтрокаДанных.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДанных.ВидУпаковки <> Перечисления.ВидыУпаковокИС.Потребительская
			И СтрокаДанных.ВидУпаковки <> Перечисления.ВидыУпаковокИС.Групповая Тогда
			Продолжить;
		КонецЕсли;
		СоставКода = СтрокаДанных.СоставКодаМаркировки;
		МРЦ = 0;
		Если СоставКода <> Неопределено И ((СоставКода.Свойство("МРЦ", МРЦ) И МРЦ = 0) ИЛИ НЕ СоставКода.Свойство("МРЦ")) Тогда
			// Нулевая МРЦ не требует подбора: сохраняем результат типовой обработки.
			Продолжить;
		КонецЕсли;
		СтрокиПодбора.Добавить(СтрокаДанных);
		Номенклатура.Добавить(СтрокаДанных.Номенклатура);
		Если ЗначениеЗаполнено(СтрокаДанных.Упаковка) Тогда
			Упаковки.Добавить(СтрокаДанных.Упаковка);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиПодбора.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	// Две выборки на весь набор, включая характеристики с одинаковыми наименованиями.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	| Характеристики.Владелец КАК Номенклатура,
	| Характеристики.Наименование КАК Наименование,
	| Характеристики.Ссылка КАК Характеристика
	|ИЗ Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	|ГДЕ Характеристики.Владелец В (&Номенклатура)
	| И НЕ Характеристики.ПометкаУдаления";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Характеристики = Запрос.Выполнить().Выгрузить();
	Характеристики.Индексы.Добавить("Номенклатура, Наименование");
	Запрос.Текст =
	"ВЫБРАТЬ Упаковки.Ссылка КАК Упаковка, Упаковки.Коэффициент КАК Коэффициент
	|ИЗ Справочник.УпаковкиНоменклатуры КАК Упаковки
	|ГДЕ Упаковки.Ссылка В (&Упаковки)";
	Запрос.УстановитьПараметр("Упаковки", Упаковки);
	Коэффициенты = Запрос.Выполнить().Выгрузить();
	Коэффициенты.Индексы.Добавить("Упаковка");

	ПодобранныеХарактеристики = Новый Соответствие;
	ЕстьЗапрет = Ложь;
	Для Каждого СтрокаДанных Из СтрокиПодбора Цикл
		ТекстЗапрета = "";
		МРЦ = 0;
		СоставКода = СтрокаДанных.СоставКодаМаркировки;
		Если СоставКода = Неопределено Или Не СоставКода.Свойство("МРЦ", МРЦ) Тогда
			ТекстЗапрета = НСтр("ru = 'В табачной марке не определена МРЦ. Продажа запрещена.'");
		ИначеЕсли СтрокаДанных.ВидУпаковки = Перечисления.ВидыУпаковокИС.Групповая Тогда
			КоличествоПачек = СтрокаДанных.КоличествоПотребительскихУпаковок;
			Если КоличествоПачек <= 1 Тогда
				КоличествоПачек = СтрокаДанных.Количество;
			КонецЕсли;
			СтрокаКоэффициента = Коэффициенты.Найти(СтрокаДанных.Упаковка, "Упаковка");
			Если КоличествоПачек <= 1 И СтрокаКоэффициента <> Неопределено Тогда
				КоличествоПачек = СтрокаКоэффициента.Коэффициент;
			КонецЕсли;
			Если КоличествоПачек <= 1 Тогда
				ТекстЗапрета = НСтр("ru = 'Не определено количество пачек в блоке. Продажа запрещена.'");
			Иначе
				МРЦ = МРЦ / КоличествоПачек;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(ТекстЗапрета) Тогда
			Наименование = Формат(МРЦ, "ЧГ=0");
			Отбор = Новый Структура("Номенклатура, Наименование", СтрокаДанных.Номенклатура, Наименование);
			Найденные = Характеристики.НайтиСтроки(Отбор);
			Если Найденные.Количество() = 1 Тогда
				ПодобранныеХарактеристики.Вставить(СтрокаДанных, Найденные[0].Характеристика);
			ИначеЕсли Найденные.Количество() = 0 Тогда
				ТекстЗапрета = СтрШаблон(НСтр("ru = 'У «%1» нет характеристики МРЦ %2. Продажа запрещена. Обратитесь к ответственному сотруднику.'"),
					СтрокаДанных.Номенклатура, Наименование);
			Иначе
				ТекстЗапрета = СтрШаблон(НСтр("ru = 'У «%1» несколько характеристик МРЦ %2. Продажа запрещена. Обратитесь к ответственному сотруднику.'"),
					СтрокаДанных.Номенклатура, Наименование);
			КонецЕсли;
		КонецЕсли;
		Если Не ПустаяСтрока(ТекстЗапрета) Тогда
			ЕстьЗапрет = Истина;
			СтрокаДанных.ОбработанСОшибками = Истина;
			СтрокаДанных.ТекстОшибки = ТекстЗапрета;
			Если СтрокаДанных.СтрокаДерева <> Неопределено Тогда
				СтрокаДанных.СтрокаДерева.ЕстьОшибки = Истина;
				СтрокаДанных.СтрокаДерева.ТекстОшибки = ТекстЗапрета;
				ДанныеПоШтрихкодам.ЕстьОшибкиВДеревеУпаковок = Истина;
			КонецЕсли;
			Если ПустаяСтрока(ДанныеПоШтрихкодам.ТекстОшибки) Тогда
				ДанныеПоШтрихкодам.ТекстОшибки = ТекстЗапрета;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьЗапрет Тогда
		// Вызывающий код может разбирать результаты построчно: весь остановленный набор получает отказ.
		Для Каждого СтрокаДанных Из СтрокиПодбора Цикл
			Если Не СтрокаДанных.ОбработанСОшибками Тогда
				СтрокаДанных.ОбработанСОшибками = Истина;
				СтрокаДанных.ТекстОшибки = ДанныеПоШтрихкодам.ТекстОшибки;
			КонецЕсли;
		КонецЦикла;
		ДанныеПоШтрихкодам.ЕстьОшибки = Истина;
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Подбор Из ПодобранныеХарактеристики Цикл
		СтрокаДанных = Подбор.Ключ;
		Если СтрокаДанных.Характеристика <> Подбор.Значение Тогда
			СтрокаДанных.Характеристика = Подбор.Значение;
			ИзмененныеСвойства = Новый Массив;
			ИзмененныеСвойства.Добавить("Характеристика");
			ШтрихкодированиеИС.ОтметитьКОбновлению(ДанныеПоШтрихкодам.СтрокиДляСохраненияКодовМаркировки,
				СтрокаДанных, ИзмененныеСвойства);
		КонецЕсли;
		Если СтрокаДанных.СтрокаДерева <> Неопределено Тогда
			СтрокаДанных.СтрокаДерева.Характеристика = Подбор.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции
//КонецМарк
