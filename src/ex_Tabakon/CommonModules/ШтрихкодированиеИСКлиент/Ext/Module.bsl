
&Вместо("ОткрытьФормуСчитыванияКодаМаркировки")
Процедура ТБКОткрытьФормуСчитыванияКодаМаркировки(ФормаВладелец, ПараметрыОткрытия, ОповещениеОЗавершении)

	ПараметрыЗамены = ТБКПараметрыЗаменыНаБК(ПараметрыОткрытия);

	Если ПараметрыЗамены = Неопределено Тогда
		ПродолжитьВызов(ФормаВладелец, ПараметрыОткрытия, ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура",    ПараметрыОткрытия.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика",  ПараметрыОткрытия.Характеристика);
	ПараметрыФормы.Вставить("ДанныеШтрихкода", ПараметрыОткрытия.ДанныеШтрихкода);
	ПараметрыФормы.Вставить("НоменклатураБК",  ПараметрыЗамены.НоменклатураБК);
	ПараметрыФормы.Вставить("Комментарий",     ПараметрыЗамены.Комментарий);

	МаркаПолная = "";
	ПараметрыЗамены.Свойство("МаркаПолная", МаркаПолная);
	ПричинаЗамены = "";
	ПараметрыЗамены.Свойство("Причина", ПричинаЗамены);

	ПараметрыФормы.Вставить("ТБКМаркаЗамены",   Строка(МаркаПолная));
	ПараметрыФормы.Вставить("ТБКПричинаЗамены", Строка(ПричинаЗамены));

	ОткрытьФорму(
		"Обработка.РМКУправляемыйРежим.Форма.ТБКФормаБыстрыйПодборПоБК",
		ПараметрыФормы, ФормаВладелец);

КонецПроцедуры

// Определяет, нужно ли подставить товар по БК вместо запроса кода маркировки.
//
// Параметры:
//  ПараметрыОткрытия - См. ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыОткрытияФормыВводаКодаМаркировки
//
// Возвращаемое значение:
//  Структура, Неопределено - См. ОбщегоНазначенияВызовСервера.ТБКПараметрыЗаменыНаБК
//
Функция ТБКПараметрыЗаменыНаБК(ПараметрыОткрытия)

	ДанныеШтрихкода = Неопределено;
	Если Не ПараметрыОткрытия.Свойство("ДанныеШтрихкода", ДанныеШтрихкода)
		Или ТипЗнч(ДанныеШтрихкода) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Случай 1. Марка не прошла проверку. Признак одноразовый: при повторном
	// сканировании решение принимается заново.
	ПараметрыЗамены = Неопределено;
	Если ДанныеШтрихкода.Свойство("ТБКЗаменаНаБК", ПараметрыЗамены) Тогда
		ДанныеШтрихкода.Удалить("ТБКЗаменаНаБК");
		Возврат ПараметрыЗамены;
	КонецЕсли;

	// Случай 2. Отсканирован штрихкод товара, кода маркировки нет.
	ПараметрыЗамены = ОбщегоНазначенияВызовСервера.ТБКПараметрыЗаменыНаБК(
		ПараметрыОткрытия.Номенклатура,
		ПараметрыОткрытия.ВидПродукции);

	Если Не ПараметрыЗамены.ЗаменаВозможна Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыЗамены;

КонецФункции
