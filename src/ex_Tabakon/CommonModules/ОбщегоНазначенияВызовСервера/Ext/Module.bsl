//Марк 2026-08-04 Мониторинг версий ПО ККТ
// Готовит данные ККТ для JSON мониторинга по результату команды GetDataKKT.
//
// Параметры:
//  ИдентификаторУстройства - СправочникСсылка.ПодключаемоеОборудование
//  ПараметрыККТXML - Строка - XML из РезультатВыполнения.ПараметрыККТXML
//  ИмяХоста - Строка - имя компьютера кассы
//
// Возвращаемое значение:
//  Структура, Неопределено - порядок вставки полей = порядок полей в JSON.
//
Функция ТБКДанныеМониторингаККТ(ИдентификаторУстройства, ПараметрыККТXML, ИмяХоста) Экспорт

	ЗаводскойНомер   = "";
	ВерсияПО         = "";
	ВерсияФФД        = "";
	ЗаводскойНомерФН = "";

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПараметрыККТXML);
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И (ЧтениеXML.Имя = "Parameters" Или ЧтениеXML.Имя = "TableParametersKKT") Тогда
			ЗаводскойНомер   = СокрЛП(ЧтениеXML.ЗначениеАтрибута("KKTSerialNumber"));
			ВерсияПО         = СокрЛП(ЧтениеXML.ЗначениеАтрибута("FirmwareVersion"));
			ВерсияФФД        = СокрЛП(ЧтениеXML.ЗначениеАтрибута("FFDVersionKKT"));
			ЗаводскойНомерФН = СокрЛП(ЧтениеXML.ЗначениеАтрибута("FNSerialNumber"));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЧтениеXML.Закрыть();

	Если ПустаяСтрока(ЗаводскойНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// АТОЛ отдает FirmwareVersion строкой вида "5.15.102 (5.17.0)":
	// до скобки - версия ПО ККТ (прошивка), в скобках - версия конфигурации ПО ККТ.
	ВерсияПрошивки     = ВерсияПО;
	ВерсияКонфигурации = "";
	ПозицияСкобки = СтрНайти(ВерсияПО, "(");
	Если ПозицияСкобки > 0 Тогда
		ВерсияПрошивки     = СокрЛП(Лев(ВерсияПО, ПозицияСкобки - 1));
		ВерсияКонфигурации = СокрЛП(СтрЗаменить(Сред(ВерсияПО, ПозицияСкобки + 1), ")", ""));
	КонецЕсли;

	Данные = Новый Структура;
	ККМ = ТБК_ККМУстройства(ИдентификаторУстройства);
	Данные.Вставить("shop"               , СокрЛП(ККМ.Магазин));
	Данные.Вставить("KKM"                , СокрЛП(ККМ));
	Данные.Вставить("hostname"           , ИмяХоста);
	Данные.Вставить("timestamp"          , XMLСтрока(ТекущаяДата()));
	Данные.Вставить("model"              , ТБКМодельККТПоЗаводскомуНомеру(ЗаводскойНомер));
	Данные.Вставить("serial_number"      , ЗаводскойНомер);
	Данные.Вставить("firmware_version"   , ВерсияПрошивки);
	Данные.Вставить("config_version"     , ВерсияКонфигурации);
	Данные.Вставить("bootloader_version" , ""); // 1С-компонента АТОЛ версию загрузчика не отдает
	Данные.Вставить("ffd_version"        , ВерсияФФД);
	Данные.Вставить("fn_serial_number"   , ЗаводскойНомерФН);

	Возврат Данные;

КонецФункции

Функция ТБК_ККМУстройства(ИдентификаторУстройства)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КассыККМ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КассыККМ КАК КассыККМ
		|ГДЕ
		|	КассыККМ.ПодключаемоеОборудование = &Устройство
		|	И НЕ КассыККМ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Устройство", ИдентификаторУстройства);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.КассыККМ.ПустаяСсылка());

КонецФункции

// Модель ККТ АТОЛ по заводскому номеру: символы 4-6 номера - код модели.
// Пример: 00105707060741 -> "057" -> АТОЛ 25Ф. Коды взяты из списка выбора
// параметра Model драйвера АТОЛ 10.x. Неизвестный код - пустая строка.
Функция ТБКМодельККТПоЗаводскомуНомеру(ЗаводскойНомер)

	Если СтрДлина(ЗаводскойНомер) < 6 Тогда
		Возврат "";
	КонецЕсли;

	Модели = Новый Соответствие;
	Модели.Вставить("093", "АТОЛ 1Ф");
	Модели.Вставить("096", "АТОЛ 2Ф");
	Модели.Вставить("067", "АТОЛ 11Ф");
