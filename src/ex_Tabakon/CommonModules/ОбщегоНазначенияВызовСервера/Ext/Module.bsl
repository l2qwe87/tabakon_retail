//Марк 2026-07-24

// Перезаписывает параметры ККТ АТОЛ (связь с ОФД/ИСМ, таймауты проверки КМ)
// у всех ККТ текущего рабочего места. Значения сохраняются в справочник
// ПодключаемоеОборудование; в кассу их запишет драйвер при ближайшем
// подключении ККТ (открытие смены, пробитие чека).
//
// Возвращаемое значение:
//  Число - количество устройств, у которых обновлены параметры.
//
Функция ТБКОбновитьПараметрыККТРабочегоМеста() Экспорт
	
	Отбор = МенеджерОборудованияКлиентСервер.СписокОборудованияОтбор();
	Отбор.ТипыПО.ККТ = Истина; 
	СписокОборудования = МенеджерОборудования.СписокОборудования(Отбор);
	
	Обновлено = 0;
	Для Каждого Устройство Из СписокОборудования Цикл
		
		Если СтрНайти(ВРег(Устройство.ИдентификаторОбъекта), "ATOL_KKT") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыУстройства = Устройство.Параметры;
		Если ТипЗнч(ПараметрыУстройства) <> Тип("Структура") Тогда
			ПараметрыУстройства = Новый Структура;
		КонецЕсли;
		
		Для Каждого Параметр Из ТБКЦелевыеПараметрыККТ() Цикл
			ПараметрыУстройства.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		
		Если МенеджерОборудования.СохранитьПараметрыУстройства(Устройство.Ссылка, ПараметрыУстройства) Тогда
			Обновлено = Обновлено + 1;
		Иначе
			_ЗаписьЖурналаРегистрации("Не удалось сохранить параметры устройства " + Устройство.Наименование,
			                  УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Обновлено;
	
КонецФункции

// Целевые значения параметров вкладки "Запись настроек в ККТ" драйвера АТОЛ 10.х (ФФД 1.2).
Функция ТБКЦелевыеПараметрыККТ()

	ПараметрыККТ = Новый Структура;
	// Связь с ОФД
	ПараметрыККТ.Вставить("P_DeviceOfdHost"    , "f1.taxcom.ru");
	ПараметрыККТ.Вставить("P_DeviceOfdPort"    , 7777);
	ПараметрыККТ.Вставить("P_DeviceOfdChannel" , 5); // EthernetOverTransport (EoT)
	// Работа с КМ: сервер ИСМ
	ПараметрыККТ.Вставить("P_DeviceIsmHost"    , "f1.taxcom.ru");
	ПараметрыККТ.Вставить("P_DeviceIsmPort"    , 8777);
	// Таймауты проверки КМ, сек.
	// ВАЖНО: компонента АТОЛ записывает таймаут в кассу, только если значение
	// ОТЛИЧАЕТСЯ от значения по умолчанию (3/10/30/5/120) - значение, равное
	// умолчанию, она считает "не задано" и пропускает. Не указывать здесь 3/10/30/5/120!
	ПараметрыККТ.Вставить("P_MarkingNumberRetries"         , 2);   // количество повторов (умолч. 3)
	ПараметрыККТ.Вставить("P_MarkingConnectionOpeningTime" , 5);  // время открытия соединения (умолч. 10)
	ПараметрыККТ.Вставить("P_MarkingResponseWaitingTime"   , 16);  // время ожидания ответа (умолч. 30)
	ПараметрыККТ.Вставить("P_MarkingDelayTimeBeforeReplay" , 2);   // задержка перед повтором (умолч. 5)
	ПараметрыККТ.Вставить("P_MarkingOpenConnectionTime"    , 30); // время открытого соединения (умолч. 120)


	Возврат ПараметрыККТ;

КонецФункции

