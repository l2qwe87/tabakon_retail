// Данная функция предназначена для извлечения номенклатуры из данных сканирования, таких как штрихкоды. 
// Она выполняет предобработку данных, определяет тип штрихкода (EAN-13 или EAN-8), 
// ищет соответствующую номенклатуру в регистрах сведений "Штрихкоды" и "ТБК_Штрихкоды"
// В случае неудачи поиска, функция добавляет данные штрихкода и возвращает Неопределено.
//
// Параметры:
//  ДанныеСканирования  - Строка - Штрихкод или QR
// Возвращаемое значение:
//   Номенклатура.Ссылка
Функция ПолучитьНоменклатуруИзДанныхСканирования(ДанныеСканирования, АвтоматическиПодгружатьНоменклатуру = Ложь) Экспорт
	
	ПроверяемыеДанные = ДанныеСканирования;
	ПроверяемыеДанные = СтрЗаменитьПоРегулярномуВыражению(ПроверяемыеДанные,   "^[010]+",  ""); //ублираем слева 001
	ПроверяемыеДанные = СтрЗаменитьПоРегулярномуВыражению(ПроверяемыеДанные,   "^[(01)]+", ""); //ублираем слева (01)
	ПроверяемыеДанные = СтрЗаменитьПоРегулярномуВыражению(ПроверяемыеДанные,   "^[0]+",    ""); //ублираем слева все нули
	ПроверяемыеДанные2 = СтрЗаменитьПоРегулярномуВыражению(ДанныеСканирования, "^[0]+",    "");
	
	ПроверяемыйШК = Неопределено;
	// Ищем EAN-13: 13 цифр с начала строки
	Если СтрДлина(ПроверяемыеДанные) >= 13 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(ПроверяемыеДанные, 13)) Тогда
		ПроверяемыйШК = Лев(ПроверяемыеДанные, 13);
		// Ищем EAN-8: 8 цифр с начала строки
	ИначеЕсли СтрДлина(ПроверяемыеДанные) >= 8 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Лев(ПроверяемыеДанные, 8)) Тогда
		ПроверяемыйШК = Лев(ПроверяемыеДанные, 8);
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Владелец КАК Номенклатура
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В(&ВариантыШтрихкодов)";
		
	МассивВаринтовШК = Новый Массив;
	
	Если ПроверяемыйШК <> Неопределено Тогда
		МассивВаринтовШК.Добавить(ПроверяемыйШК);                                      
		МассивВаринтовШК.Добавить("0" + ПроверяемыйШК);                                  
		МассивВаринтовШК.Добавить("00" + ПроверяемыйШК);
		МассивВаринтовШК.Добавить("000" + ПроверяемыйШК);
		МассивВаринтовШК.Добавить("0000" + ПроверяемыйШК);
		МассивВаринтовШК.Добавить("00000" + ПроверяемыйШК);
		МассивВаринтовШК.Добавить("000000" + ПроверяемыйШК);
	КонецЕсли;
	МассивВаринтовШК.Добавить(Лев(ПроверяемыеДанные2, 13));
	МассивВаринтовШК.Добавить("0" + Лев(ПроверяемыеДанные2, 13));
	Запрос.УстановитьПараметр("ВариантыШтрихкодов", МассивВаринтовШК);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	иначе   
		//Вик 2025-06-26
		Если АвтоматическиПодгружатьНоменклатуру тогда  
			Номенклатура = Неопределено;
			
			Попытка
				ЗагрузитьНоменклатуру_ИзНовойУТ(МассивВаринтовШК);  
				Номенклатура = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатуруИзДанныхСканирования(ДанныеСканирования);  
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
			Если Номенклатура <> Неопределено тогда   
				Возврат Номенклатура;
			иначе 
				ДобавитьДанныеШтрихкодаК_ТБК_ЗапросДанныхУ_УТ(ПроверяемыйШК);
				Возврат Неопределено;
			КонецЕсли; 
			
		иначе
			ДобавитьДанныеШтрихкодаК_ТБК_ЗапросДанныхУ_УТ(ПроверяемыйШК);
			Возврат Неопределено;
		КонецЕсли;
		//   
	КонецЕсли; 

КонецФункции // ()

Функция ЗагрузитьНоменклатуру_ИзНовойУТ(МассивВаринтовШК) Экспорт  
	
	Прокси = ОбщегоНазначенияВызовСервера.ПолучитьПрокси("123456", "WS_User", "http://mx.tbkon.ru:1777/trade/ws/tbk?wsdl");
	Json = ОбщегоНазначения.СтруктураВjson_Общая(МассивВаринтовШК);
	Данные = Прокси.get_nomenklat(Json);
	Прокси = Неопределено;   
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбработкаОбмена = Обработки.УниверсальныйОбменДаннымиXML.Создать();
	ОбработкаОбмена.РежимОбмена = "Загрузка";
	ОбработкаОбмена.ВыводВОкноСообщенийИнформационныхСообщений = Ложь;
	ОбработкаОбмена.ВыводВПротоколИнформационныхСообщений      = Ложь;
	ОбработкаОбмена.ВыводВПротоколСообщенийОбОшибках           = Ложь;
	
	РаботаВозможна = ОбработкаОбмена.ВыполнитьДействияПередЧтениемДанных(Данные.Получить());
	
	Если НЕ РаботаВозможна Тогда
		Сообщить("Ошибка обмена данных!");
	КонецЕсли;
	
	ОбработкаОбмена.ПроизвестиЧтениеДанных(ТекстОшибки);
	ОбработкаОбмена.ВыполнитьДействияПослеЗавершенияЧтенияДанных();
	
КонецФункции

