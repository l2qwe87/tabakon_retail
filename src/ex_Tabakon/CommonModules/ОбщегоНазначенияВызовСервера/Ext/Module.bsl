//Марк ROZ-14 замена товара на БК при непройденной проверке марки
// Определяет, можно ли предложить кассиру замену товара на БК, и возвращает данные для подбора.
// Вызывается только когда марка уже не прошла проверку, поэтому один серверный вызов
// приходится на неуспешное сканирование, а не на каждое.
//
// Параметры:
//  Номенклатура - ОпределяемыйТип.Номенклатура       - номенклатура отсканированной марки
//  ВидПродукции - СправочникСсылка.ВидыПродукцииИС   - вид продукции ИС
//  GTIN         - Строка                             - GTIN для журнала регистрации
//
// Возвращаемое значение:
//  Структура:
//   * ЗаменаВозможна - Булево                        - Истина, если найден товар-заменитель
//   * НоменклатураБК - СправочникСсылка.Номенклатура - товар, который нужно пробить вместо марки
//   * Комментарий    - Строка                        - заполняется на клиенте
//
Функция ТБКПараметрыЗаменыНаБК(Номенклатура, ВидПродукции, GTIN = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЗаменаВозможна", Ложь);
	Результат.Вставить("НоменклатураБК", Справочники.Номенклатура.ПустаяСсылка());
	Результат.Вставить("Комментарий",    "");

	Если Не ЗначениеЗаполнено(Номенклатура)
		Или Не ТБКВидПродукцииСЗаменойНаБК(ВидПродукции) Тогда
		Возврат Результат;
	КонецЕсли;

	НоменклатураБК = ПолучитьНоменклатураБК(Номенклатура);

	Если НоменклатураБК.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ЗаменаВозможна = Истина;
	Результат.НоменклатураБК = НоменклатураБК;

	Возврат Результат;

КонецФункции

// Проверяет, предусмотрена ли для вида продукции замена товара на БК.
//
// Сравнение идет по представлению, а не по ссылке: ВидПродукции приходит либо
// ссылкой на справочник ВидыПродукцииИС, либо на КлючиВидовПродукцииИС
// (см. ШтрихкодированиеОбщегоНазначенияМОТП.КоллекцияДополнительныхКолонокДереваУпаковокИСМП),
// поэтому сравнение ссылок с элементами одного справочника не срабатывает.
//
// Параметры:
//  ВидПродукции - СправочникСсылка.ВидыПродукцииИС, СправочникСсылка.КлючиВидовПродукцииИС
//
// Возвращаемое значение:
//  Булево
//
Функция ТБКВидПродукцииСЗаменойНаБК(ВидПродукции)

	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТБКВидыПродукцииСЗаменойНаБК().Найти(СокрЛП(Строка(ВидПродукции))) <> Неопределено;

КонецФункции

// Наименования видов продукции, для которых предусмотрена замена товара на БК.
//
// TODO ROZ-14: перенести список в регистр сведений, чтобы он настраивался без изменения кода.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ТБКВидыПродукцииСЗаменойНаБК()

	Наименования = Новый Массив;
	Наименования.Добавить("Табачная продукция");
	Наименования.Добавить("АТП");
	Наименования.Добавить("Товары легкой промышленности и одежда 2025");
	Наименования.Добавить("Товары легкой промышленности и одежда");

	Возврат Наименования;

КонецФункции
//КонецМарк
