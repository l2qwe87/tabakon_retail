	                      |ГДЕ
	                      |	ПробиватьПоБК.НоменклатурнаяГруппа.Код В(&Код)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата УБЫВ");
	Массив_ПК = СтрРазделить(ПК, "/");
	Запрос.УстановитьПараметр("Код", Массив_ПК);

