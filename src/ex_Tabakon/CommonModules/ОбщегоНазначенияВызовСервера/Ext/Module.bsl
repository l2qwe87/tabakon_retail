#Область VKTeams

Процедура ОтправитьФайлВVKTeams(АдресСервера, Порт, ТБ, ФорматФайла, NameFile = "document") Экспорт

    // Сохраняем во временный файл
    ИмяФайла = ПолучитьИмяВременногоФайла(ФорматФайла);
    Если ФорматФайла = ".xlsx" Тогда
		ТБ.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	//ИначеЕсли ФорматФайла = ".pdf" Тогда
	//    ТБ.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
    КонецЕсли;

    // Читаем файл и кодируем в Base64
    ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
    Base64Строка = Base64Строка(ДвоичныеДанные);
    // Убираем переносы строк которые добавляет 1С
    Base64Строка = СтрЗаменить(Base64Строка, Символы.ПС, "");
    Base64Строка = СтрЗаменить(Base64Строка, Символы.ВК, "");

    // Формируем JSON
    ПолноеИмяФайла = NameFile + ФорматФайла;
    Тело = "{""filename"": """ + ПолноеИмяФайла + """, ""file_b64"": """ + Base64Строка + """, ""caption"": """ + NameFile + """}";

    // Отправляем на бота
    HTTPСоединение = Новый HTTPСоединение(АдресСервера, Порт);
    HTTPЗапрос = Новый HTTPЗапрос("/notify/file/b64");
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
    HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);

    Попытка
        ОтветHTTP = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        Сообщить("Ответ: " + ОтветHTTP.ПолучитьТелоКакСтроку());
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;

