Функция UploadPhotoTBKApplication(вхПараметры) ЭКСПОРТ
	
	Попытка
		
		СтукрутраFTP = ОбщегоНазначения.ПолучитьСтруктуруПодключенияFTP();
		Соединение = Новый FTPСоединение(СтукрутраFTP.ИмяFTPСервера, СтукрутраFTP.Порт, СтукрутраFTP.Пользователь, СтукрутраFTP.Пароль);
		
		КаталогИб = СтрокаСоединенияИнформационнойБазы();
		КаталогИб = СтрЗаменить(КаталогИб, "File=""", "");
		КаталогИб = СтрЗаменить(КаталогИб, """;", ""); 
		//Проверка существования каталога +++
		Строка_Каталог_photo = КаталогИб + "\photo";
		Строка_Каталог_chat = КаталогИб + "\photo\TBKzayavki";
		файл_Каталог_photo = Новый Файл(Строка_Каталог_photo);
		если файл_Каталог_photo.Существует() Тогда
			файл_Каталог_chat = Новый Файл(Строка_Каталог_chat);
			Если НЕ файл_Каталог_chat.Существует() Тогда
				СоздатьКаталог(Строка_Каталог_chat);	
			КонецЕсли;
		иначе
			СоздатьКаталог(Строка_Каталог_photo);
			СоздатьКаталог(Строка_Каталог_chat);
		КонецЕсли;
		//Проверка существования каталога ---
		Файл_Фотка_FTP = Соединение.НайтиФайлы(СтукрутраFTP.КаталогНаСервере + "photo/TBKzayavki/","*");
		для каждого Файл Из Файл_Фотка_FTP Цикл
			если СтрНайти(Файл.Имя, "_Shipped") тогда Продолжить; КонецЕсли;
			ЗаписьЖурналаРегистрации("Информаци" , УровеньЖурналаРегистрации.Информация, "Зашел, фото: " + Файл.Имя);
			ПутьКФайлу = ПолучитьИмяВременногоФайла(Файл.Имя);
			Соединение.Получить(Файл.ПолноеИмя, ПутьКФайлу);
			ПереместитьФайл(ПутьКФайлу, Строка_Каталог_chat + "\" + Файл.Имя); 
			Соединение.Переместить(Файл.ПолноеИмя, Файл.Путь + Файл.ИмяБезРасширения + "_Shipped" + Файл.Расширение); 
		КонецЦикла;
		Возврат Истина;
		
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки; 		
	
КонецФункции

Функция SetTaxPatent(вхПараметры) Экспорт

	НачатьТранзакцию();
	Попытка
		
		эл =  Новый Структура();
		Организация = Справочники.Организации.НайтиПоНаименованию(вхПараметры.Организация);
		
		Если вхПараметры.ЗаписыватьНалог Тогда
			
			рег = РегистрыСведений.ПрименениеСистемНалогообложения.СоздатьМенеджерЗаписи();
			рег.Период = Дата(вхПараметры.ДатаЗаписи);
			рег.Организация = Организация;
			рег.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ[вхПараметры.СистемаНалогообложения];
			рег.ОсвобожденОтНДС = вхПараметры.ОсвобожденОтНДС;
			рег.Записать();			
						
			эл.Вставить("УспехЗаписиНовойСтроки", 			Истина);
			эл.Вставить("НовЗвписьПериод", 					Строка(рег.Период));
			эл.Вставить("НовЗвписьОрганизация", 			Строка(рег.Организация));
			эл.Вставить("НовЗвписьСистемаНалогообложения", 	Строка(рег.СистемаНалогообложения));
			эл.Вставить("НовЗвписьОсвобожденОтНДС", 		Строка(рег.ОсвобожденОтНДС));			
			эл.Вставить("НовЗвписьОтвет",					Строка(Истина));
			
		КонецЕсли;
		 
		Если вхПараметры.ПолучитьСписок Тогда
			
			Набор = РегистрыСведений.ПрименениеСистемНалогообложения.СоздатьНаборЗаписей();
			Набор.Отбор.Организация.Установить(Организация);
			Набор.Прочитать();

			МассивСтрок = Новый Массив;
			для каждого Строка из Набор Цикл
				элМассива = Новый Структура();
				элМассива.Вставить("Период", 				Строка(Строка.Период));
				элМассива.Вставить("Организация",			Строка(Строка.Организация));
				элМассива.Вставить("СистемаНалогообложения",Строка(Строка.СистемаНалогообложения));
				элМассива.Вставить("ОсвобожденОтНДС",		Строка(Строка.СистемаНалогообложения));
				МассивСтрок.Добавить(элМассива);
			КонецЦикла;
			
			эл.Вставить("МассивЗаписейРегистра", МассивСтрок);
		КонецЕсли;		
		
		эл.Вставить("ОбщийОтвет", Истина);
		ЗафиксироватьТранзакцию();
		Возврат ОбщегоНазначения.СтруктураВjson_Общая(эл); 
		
	Исключение
		
		ОтменитьТранзакцию();	
		эл.Вставить("ОбщийОтвет", Ложь);
		эл.Вставить("ОписаниеОшибки", ОписаниеОшибки());
		Возврат ОбщегоНазначения.СтруктураВjson_Общая(эл); 
		
	КонецПопытки;
	
КонецФункции


Функция WriteDocYcenka(вхПараметры) ЭКСПОРТ
		
	Попытка	
		НовыйЭл							=	Документы.ТБКУценка.СоздатьДокумент();
		НовыйЭл.Комментарий				=	"Уценка в офисе: " + вхПараметры.Номер;
		НовыйЭл.Дата					=	ТекущаяДата();
		НовыйЭл.Магазин					=	ОбщегоНазначения.ПолучитьСкладИзООРП();
		НовыйЭл.Сформирован				=	Истина;
		НовыйЭл.флОтправленВУТ			=	Истина;		

		//товары
		Для каждого Строка из вхПараметры.Данные цикл
            Номенклат	=	Справочники.Номенклатура.НайтиПоКоду(Строка.НоменклатураКод);
			
			СтрокаКуар			=	Строка(Строка.QR);
			СтрокаКуарУценки	=	Строка(Строка.QR_Уценки);  
			
			Если СтрокаКуар = "" тогда//для штрихкодов   
				НовСтрока	=	НовыйЭл.Товары.Добавить();
				НовСтрока.Номенклатура	= Номенклат;
				НовСтрока.QR_Уценки		= СтрокаКуарУценки;
			КонецЕсли;

			//Парсинг куар и обработка
			Пока СтрокаКуар <> "" цикл 
				Разделитель		=	Найти(СтрокаКуар,Символ(169));
				Разделитель1	=	Найти(СтрокаКуарУценки,Символ(169));

				Если Разделитель >0 тогда
					НужныйКуар			=	Лев(СтрокаКуар,Разделитель - 1);
					НужныйКуар_Уценки	=	Лев(СтрокаКуарУценки,Разделитель1 - 1);
					
					НовСтрока	=	НовыйЭл.Товары.Добавить();
					НовСтрока.Номенклатура	= Номенклат;
					НовСтрока.QR 			= НужныйКуар;
					НовСтрока.QR_Уценки		= НужныйКуар_Уценки;
			
					СтрокаКуар			=	Сред(СтрокаКуар,Разделитель+1);	
					СтрокаКуарУценки	=	Сред(СтрокаКуарУценки,Разделитель1+1);	
				иначе      
					
					НовСтрока	=	НовыйЭл.Товары.Добавить();
					НовСтрока.Номенклатура	= Номенклат;
					НовСтрока.QR 			= СтрокаКуар;
					НовСтрока.QR_Уценки		= СтрокаКуарУценки;
			
					СтрокаКуар			=	"";						
				КонецЕсли;
			КонецЦикла;
			
			
		КонецЦикла;
		
		НовыйЭл.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат Истина;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

КонецФункции


Функция SetSettings_PoshtychnayaProdazha(вхПараметры) Экспорт 
	
	ВидНоменклатурыОбъект	=	Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Сигары, сигариллы"); 
	
	Если ВидНоменклатурыОбъект.Пустая() тогда
		ВидНоменклатурыОбъект	=	Справочники.ВидыНоменклатуры.СоздатьЭлемент(); 
		
		ВидНоменклатурыОбъект.Заполнить(Неопределено);
		ВидНоменклатурыОбъект.УстановитьНовыйКод();
		
		ВидНоменклатурыОбъект.Наименование		=	"Сигары, сигариллы"; 
		ВидНоменклатурыОбъект.ТипНоменклатуры	=	Перечисления.ТипыНоменклатуры.Товар;		
		ВидНоменклатурыОбъект.ПризнакПредметаРасчета = Справочники.ПризнакиПредметовРасчета.Товар;
		
		ОсобенностьУчетаНоменклатуры	=	Перечисления.ОсобенностиУчетаНоменклатуры.АльтернативныйТабак;
		
		ВидНоменклатурыОбъект.ОсобенностьУчета = ОсобенностьУчетаНоменклатуры;
		ВидНоменклатурыОбъект.ПризнакПредметаРасчета = Справочники.ПризнакиПредметовРасчета.ПодакцизныйТоварМаркируемыйСИИмеющийКМ;
		
		ВидНоменклатурыОбъект.ИспользованиеХарактеристик              = Перечисления.ВариантыВеденияДополнительныхДанныхПоНоменклатуре.НеИспользовать;
		ВидНоменклатурыОбъект.ИспользоватьХарактеристики              = Ложь;
		
		ВидНоменклатурыОбъект.Записать();
			
	КонецЕсли;
	
	
	Номенклатура = Справочники.Номенклатура.НайтиПоКоду(вхПараметры.Код);
	
	Если Номенклатура.Пустая() тогда
		Возврат "Нет номенклатуры на рознице!!";
	КонецЕсли;
	
	
	Если Номенклатура.ВидНоменклатуры <> ВидНоменклатурыОбъект.Ссылка тогда  
		
		Об = Номенклатура.ПолучитьОбъект();
		
		Запрос	=	Новый Запрос("ВЫБРАТЬ
		      	 	             |	УпаковкиНоменклатуры.Ссылка КАК Ссылка,
		      	 	             |	УпаковкиНоменклатуры.Коэффициент КАК Коэффициент
		      	 	             |ИЗ
		      	 	             |	Справочник.УпаковкиНоменклатуры КАК УпаковкиНоменклатуры
		      	 	             |ГДЕ
		      	 	             |	УпаковкиНоменклатуры.Владелец = &Владелец
		      	 	             |	И УпаковкиНоменклатуры.Коэффициент > 1
		      	 	             |	И НЕ УпаковкиНоменклатуры.ПометкаУдаления
		      	 	             |	И УпаковкиНоменклатуры.Наименование ПОДОБНО ""%упак%""");  
		
		Запрос.УстановитьПараметр("Владелец", Номенклатура);   
		
		Рез = Запрос.Выполнить().Выбрать();
		
		Если Рез.Количество() = 1 тогда
			рез.Следующий();
			
			НачатьТранзакцию();
			
			Об.ВидНоменклатуры	=	ВидНоменклатурыОбъект.Ссылка; 		
			Об.НаборУпаковок	=	Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;	
			
			Об.ТипНоменклатуры	=	Об.ВидНоменклатуры.ТипНоменклатуры;
			Об.ОсобенностьУчета	=	Об.ВидНоменклатуры.ОсобенностьУчета; 
			Об.Записать();
			
			Рег = РегистрыСведений.ОписаниеНоменклатурыИС.СоздатьМенеджерЗаписи();
			Рег.Номенклатура							=	Об.Ссылка;
			Рег.ЕмкостьПотребительскойУпаковки			=	Рез.Коэффициент;
			Рег.КоличествоВПотребительскойУпаковке		=	Рез.Коэффициент;
			Рег.ВариантЧастичногоВыбытия				=	Перечисления.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура;
			Рег.ВариантИспользованияЕдиницыХранения		=	Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ЗаданУпаковками;
			
			Рег.ПотребительскаяУпаковка		=	Рез.Ссылка;
			Рег.УпаковкаЧастичногоВыбытия	=	Об.Ссылка.ЕдиницаИзмерения;
			
			
			Рег.Записать();	 
			
			ЗафиксироватьТранзакцию(); 
		иначе
			Возврат "Нет единиц измерения на рознице!!";
		КонецЕсли; 	
	Иначе 
		возврат истина; 
	КонецЕсли;   
	
	
КонецФункции // ()
////////////////////////////////////////////////////////////////////////////////
// Регистрация документов к обмену с УТ 10.3 (план обмена ОбменРозницаУправлениеТорговлей103)

// Регистрирует документы за период к обмену на узел УТ.
// Регистрация безусловная: отборы узла (организации, склады, дата начала выгрузки)
// и типовые правила регистрации объектов не проверяются - как "дополнительная
// регистрация данных" в форме настройки синхронизации.
//
// вхПараметры - Структура:
//  * Node       - Строка - обязательный. Код узла плана обмена ОбменРозницаУправлениеТорговлей103.
//                          Если по коду не найден, ищется по наименованию.
//  * DateFrom   - Строка - обязательный. Начало периода: "ГГГГММДД", "ГГГГММДДЧЧММСС",
//                          "ДД.ММ.ГГГГ [ЧЧ:ММ:СС]" или "ГГГГ-ММ-ДД[ТЧЧ:ММ:СС]".
//  * DateTo     - Строка - обязательный. Окончание периода. Если время не задано, берется конец дня.
//  * DocTypes   - Массив, Строка - необязательный. Имена видов документов; строка - через запятую.
//                          По умолчанию все: ОтчетОРозничныхПродажах, ВозвратТоваровОтПокупателя,
//                          ПриходныйКассовыйОрдер, РасходныйКассовыйОрдер,
//                          ПриходныйОрдерНаТовары, РасходныйОрдерНаТовары.
//  * OnlyPosted - Булево - необязательный. Только проведенные документы. По умолчанию Ложь.
//
// Возвращаемое значение:
//  Структура - Success, Error, Node, DateFrom, DateTo, Total, Details.
//
Функция RegisterDocsForExchange(вхПараметры) ЭКСПОРТ

	Результат = Новый Структура;
	Результат.Вставить("Success",  Ложь);
	Результат.Вставить("Error",    "");
	Результат.Вставить("Node",     "");
	Результат.Вставить("DateFrom", "");
	Результат.Вставить("DateTo",   "");
	Результат.Вставить("Total",    0);
	Результат.Вставить("Details",  Новый Массив);

	Попытка

		УстановитьПривилегированныйРежим(Истина);

		ДатаС  = ТБК_ГраницаПериодаИзПараметра(вхПараметры, "DateFrom", Ложь);
		ДатаПо = ТБК_ГраницаПериодаИзПараметра(вхПараметры, "DateTo",   Истина);

		Если ДатаС > ДатаПо Тогда
			ВызватьИсключение "Начало периода больше окончания: "
				+ Формат(ДатаС, "ДФ=""дд.ММ.гггг ЧЧ:мм:сс""") + " - "
				+ Формат(ДатаПо, "ДФ=""дд.ММ.гггг ЧЧ:мм:сс""") + ".";
		КонецЕсли;

		Узел           = ТБК_НайтиУзелОбменаУТ103(вхПараметры);
		ВидыДокументов = ТБК_ВидыДокументовОбменаУТ103(вхПараметры);

		ТолькоПроведенные = Ложь;
		Если ТипЗнч(вхПараметры) = Тип("Структура") Тогда
			вхПараметры.Свойство("OnlyPosted", ТолькоПроведенные);
		КонецЕсли;
		ТолькоПроведенные = (ТолькоПроведенные = Истина ИЛИ ВРег(СокрЛП(Строка(ТолькоПроведенные))) = "TRUE");

		Всего = 0;

		Для Каждого ИмяВида Из ВидыДокументов Цикл

			ТекстЗапроса =
			"ВЫБРАТЬ
			|	Док.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.%1 КАК Док
			|ГДЕ
			|	Док.Дата МЕЖДУ &ДатаС И &ДатаПо
			|	%2
			|
			|УПОРЯДОЧИТЬ ПО
			|	Док.Дата";

			Запрос = Новый Запрос;
			Запрос.Текст = СтрШаблон(ТекстЗапроса, ИмяВида, ?(ТолькоПроведенные, "И Док.Проведен", ""));
			Запрос.УстановитьПараметр("ДатаС",  ДатаС);
			Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

			Выборка = Запрос.Выполнить().Выбрать();

			КоличествоВида = 0;
			Пока Выборка.Следующий() Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Выборка.Ссылка);
				КоличествоВида = КоличествоВида + 1;
			КонецЦикла;

			ДетализацияВида = Новый Структура;
			ДетализацияВида.Вставить("DocType", ИмяВида);
			ДетализацияВида.Вставить("Count",   КоличествоВида);
			Результат.Details.Добавить(ДетализацияВида);

			Всего = Всего + КоличествоВида;

		КонецЦикла;

		Результат.Node     = СокрЛП(Узел.Код) + " (" + СокрЛП(Узел.Наименование) + ")";
		Результат.DateFrom = Формат(ДатаС,  "ДФ=""дд.ММ.гггг ЧЧ:мм:сс""");
		Результат.DateTo   = Формат(ДатаПо, "ДФ=""дд.ММ.гггг ЧЧ:мм:сс""");
		Результат.Total    = Всего;
		Результат.Success  = Истина;

		ЗаписьЖурналаРегистрации("ТБК.РегистрацияДокументовКОбмену",
			УровеньЖурналаРегистрации.Информация, , Узел,
			"Зарегистрировано документов: " + Строка(Всего)
				+ " за период " + Результат.DateFrom + " - " + Результат.DateTo + ".");

	Исключение

		Результат.Success = Ложь;
		Результат.Error   = ОписаниеОшибки();

		ЗаписьЖурналаРегистрации("ТБК.РегистрацияДокументовКОбмену",
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

	Возврат Результат;

КонецФункции

// Принимает от УТ текст конкурса ОП для главной формы РМК и заменяет им запись регистра ТБК_СообщениеКонкурсаОП:
// на кассе хранится только последнее присланное, что показывать - решает УТ.
//
// Параметры:
//  вхПараметры - Структура - разобранный JSON из УТ:
//   * text - Строка - что показать продавцу: «Вы на 3 месте из 15 магазинов…», «Конкурса сейчас нет».
//
// Возвращаемое значение:
//  Структура - Success, Error.
//
Функция SetMetricOP(Знач вхПараметры) ЭКСПОРТ

	Результат = Новый Структура("Success, Error", Ложь, "");

	Попытка

		ПараметрыОП = Новый Структура("text", "");
		Если ТипЗнч(вхПараметры) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыОП, вхПараметры);
		КонецЕсли;

		// Пустой текст оставил бы продавца с пустым экраном вместо прошлого сообщения, null - со словом «Неопределено».
		Если ТипЗнч(ПараметрыОП.text) <> Тип("Строка") Или ПустаяСтрока(ПараметрыОП.text) Тогда
			ВызватьИсключение "text должен быть непустой строкой.";
		КонецЕсли;
		Текст = СокрЛП(ПараметрыОП.text);

		Набор  = РегистрыСведений.ТБК_СообщениеКонкурсаОП.СоздатьНаборЗаписей();
		Запись = Набор.Добавить();
		Запись.Текст    = Текст;
		Запись.Получено = ТекущаяДатаСеанса();
		Набор.Записать();

		Результат.Success = Истина;

	Исключение

		Результат.Error = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ТБК.МетрикаОП", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

	Возврат Результат;

КонецФункции

// Ищет узел плана обмена ОбменРозницаУправлениеТорговлей103 по параметру Node.
//
Функция ТБК_НайтиУзелОбменаУТ103(вхПараметры)

	КодУзла = "";
	Если ТипЗнч(вхПараметры) = Тип("Структура") Тогда
		вхПараметры.Свойство("Node", КодУзла);
	КонецЕсли;
	КодУзла = СокрЛП(Строка(КодУзла));

	Если ПустаяСтрока(КодУзла) Тогда
		ВызватьИсключение "Не задан обязательный параметр Node - код узла обмена с УТ. "
			+ ТБК_СписокУзловОбменаУТ103();
	КонецЕсли;

	Узел = ПланыОбмена.ОбменРозницаУправлениеТорговлей103.НайтиПоКоду(КодУзла);

	Если Не ЗначениеЗаполнено(Узел) Тогда
		Узел = ПланыОбмена.ОбменРозницаУправлениеТорговлей103.НайтиПоНаименованию(КодУзла, Истина);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Узел) Тогда
		ВызватьИсключение "Узел обмена """ + КодУзла + """ не найден. " + ТБК_СписокУзловОбменаУТ103();
	КонецЕсли;

	Если Узел = ПланыОбмена.ОбменРозницаУправлениеТорговлей103.ЭтотУзел() Тогда
		ВызватьИсключение "Узел """ + КодУзла + """ - это текущая база, регистрация на нем невозможна. "
			+ ТБК_СписокУзловОбменаУТ103();
	КонецЕсли;

	Если Узел.ПометкаУдаления Тогда
		ВызватьИсключение "Узел обмена """ + КодУзла + """ помечен на удаление.";
	КонецЕсли;

	Возврат Узел;

КонецФункции

// Возвращает подсказку со списком узлов обмена с УТ, доступных для регистрации.
//
Функция ТБК_СписокУзловОбменаУТ103()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Узлы.Код КАК Код,
	|	Узлы.Наименование КАК Наименование
	|ИЗ
	|	ПланОбмена.ОбменРозницаУправлениеТорговлей103 КАК Узлы
	|ГДЕ
	|	НЕ Узлы.ЭтотУзел
	|	И НЕ Узлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код");

	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(СокрЛП(Выборка.Код) + " (" + СокрЛП(Выборка.Наименование) + ")");
	КонецЦикла;

	Если Список.Количество() = 0 Тогда
		Возврат "В базе нет узлов обмена с УТ 10.3.";
	КонецЕсли;

	Возврат "Доступные узлы: " + СтрСоединить(Список, "; ") + ".";

КонецФункции

// Возвращает массив имен документов для регистрации по параметру DocTypes.
//
Функция ТБК_ВидыДокументовОбменаУТ103(вхПараметры)

	ДопустимыеВиды = Новый Массив;
	ДопустимыеВиды.Добавить("ОтчетОРозничныхПродажах");
	ДопустимыеВиды.Добавить("ВозвратТоваровОтПокупателя");
	ДопустимыеВиды.Добавить("ПриходныйКассовыйОрдер");
	ДопустимыеВиды.Добавить("РасходныйКассовыйОрдер");
	ДопустимыеВиды.Добавить("ПриходныйОрдерНаТовары");
	ДопустимыеВиды.Добавить("РасходныйОрдерНаТовары");

	Заданные = Неопределено;
	Если ТипЗнч(вхПараметры) = Тип("Структура") Тогда
		вхПараметры.Свойство("DocTypes", Заданные);
	КонецЕсли;

	Если Заданные = Неопределено Тогда
		Возврат ДопустимыеВиды;
	КонецЕсли;

	Если ТипЗнч(Заданные) = Тип("Строка") Тогда
		Заданные = СтрРазделить(Заданные, ",", Ложь);
	КонецЕсли;

	Если ТипЗнч(Заданные) <> Тип("Массив") Тогда
		ВызватьИсключение "Параметр DocTypes должен быть массивом или строкой имен документов через запятую.";
	КонецЕсли;

	Результат = Новый Массив;

	Для Каждого ЗаданныйВид Из Заданные Цикл

		ИмяВида = СокрЛП(Строка(ЗаданныйВид));
		Если ПустаяСтрока(ИмяВида) Тогда
			Продолжить;
		КонецЕсли;

		НайденныйВид = "";
		Для Каждого ДопустимыйВид Из ДопустимыеВиды Цикл
			Если ВРег(ДопустимыйВид) = ВРег(ИмяВида) Тогда
				НайденныйВид = ДопустимыйВид;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ПустаяСтрока(НайденныйВид) Тогда
			ВызватьИсключение "Недопустимый вид документа в DocTypes: """ + ИмяВида + """. Допустимы: "
				+ СтрСоединить(ДопустимыеВиды, ", ") + ".";
		КонецЕсли;

		Если Результат.Найти(НайденныйВид) = Неопределено Тогда
			Результат.Добавить(НайденныйВид);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат ДопустимыеВиды;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает границу периода из параметра запроса.
// Поддерживает "ГГГГММДД", "ГГГГММДДЧЧММСС", "ДД.ММ.ГГГГ [ЧЧ:ММ:СС]", "ГГГГ-ММ-ДД[ТЧЧ:ММ:СС]".
// Если время не задано, для окончания периода берется конец дня.
//
Функция ТБК_ГраницаПериодаИзПараметра(вхПараметры, ИмяПараметра, ЭтоОкончаниеПериода)

	Значение = Неопределено;
	Если ТипЗнч(вхПараметры) = Тип("Структура") Тогда
		вхПараметры.Свойство(ИмяПараметра, Значение);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат ?(ЭтоОкончаниеПериода И НачалоДня(Значение) = Значение, КонецДня(Значение), Значение);
		КонецЕсли;
		Значение = "";
	КонецЕсли;

	Стр = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если ПустаяСтрока(Стр) Тогда
		ВызватьИсключение "Не задан обязательный параметр " + ИмяПараметра + " (граница периода).";
	КонецЕсли;

	ЗначениеДаты = Неопределено;
	ВремяЗадано  = Ложь;

	Если СтрДлина(Стр) = 8 ИЛИ СтрДлина(Стр) = 14 Тогда
		Попытка
			ЗначениеДаты = Дата(Стр);
			ВремяЗадано  = (СтрДлина(Стр) = 14);
		Исключение
			ЗначениеДаты = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ЗначениеДаты = Неопределено Тогда

		Нормализованная  = СтрЗаменить(СтрЗаменить(ВРег(Стр), "T", " "), ",", ".");
		ЧастиДатыВремени = СтрРазделить(Нормализованная, " ", Ложь);

		Если ЧастиДатыВремени.Количество() = 0 Тогда
			ВызватьИсключение "Не удалось разобрать дату в параметре " + ИмяПараметра + ": " + Стр;
		КонецЕсли;

		Год = 0; Месяц = 0; День = 0;

		Если СтрНайти(ЧастиДатыВремени[0], "-") > 0 Тогда
			ЧастиДаты = СтрРазделить(ЧастиДатыВремени[0], "-", Ложь);
			Если ЧастиДаты.Количество() <> 3 Тогда
				ВызватьИсключение "Не удалось разобрать дату в параметре " + ИмяПараметра + ": " + Стр;
			КонецЕсли;
			Год = Число(ЧастиДаты[0]); Месяц = Число(ЧастиДаты[1]); День = Число(ЧастиДаты[2]);
		Иначе
			ЧастиДаты = СтрРазделить(ЧастиДатыВремени[0], ".", Ложь);
			Если ЧастиДаты.Количество() <> 3 Тогда
				ВызватьИсключение "Не удалось разобрать дату в параметре " + ИмяПараметра + ": " + Стр;
			КонецЕсли;
			День = Число(ЧастиДаты[0]); Месяц = Число(ЧастиДаты[1]); Год = Число(ЧастиДаты[2]);
		КонецЕсли;

		Час = 0; Минута = 0; Секунда = 0;
		Если ЧастиДатыВремени.Количество() > 1 Тогда
			ЧастиВремени = СтрРазделить(ЧастиДатыВремени[1], ":", Ложь);
			Час     = ?(ЧастиВремени.Количество() > 0, Число(ЧастиВремени[0]), 0);
			Минута  = ?(ЧастиВремени.Количество() > 1, Число(ЧастиВремени[1]), 0);
			Секунда = ?(ЧастиВремени.Количество() > 2, Число(ЧастиВремени[2]), 0);
			ВремяЗадано = Истина;
		КонецЕсли;

		ЗначениеДаты = Дата(Год, Месяц, День, Час, Минута, Секунда);

	КонецЕсли;

	Если ЭтоОкончаниеПериода И Не ВремяЗадано Тогда
		ЗначениеДаты = КонецДня(ЗначениеДаты);
	КонецЕсли;

	Возврат ЗначениеДаты;

КонецФункции

// Принимает последовательные пакеты УТ через ws_tbk.Post.
// Параметры:
//   Пакет - Структура - Stage (status/data/cleanup), Generation, SnapshotId, Page, Pages, Total, Rows.
// Возвращаемое значение:
//   Структура - Success, поколение обмена, для записи также накопительные итоги, номер пакета и Done.
Функция ApplyBarcodeBatch(Пакет) Экспорт
	Попытка
		ХешБазы = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешБазы.Добавить(СтрокаСоединенияИнформационнойБазы());
		Корень = "C:\app\BarcodeSync\" + ПолучитьHexСтрокуИзДвоичныхДанных(ХешБазы.ХешСумма) + "\";
		СоздатьКаталог(Корень);
		// Писатель один для данной публикации. При завершении рабочего процесса ОС отпускает файл.
		Поток = Новый ФайловыйПоток(Корень + "exchange.lock", РежимОткрытияФайла.ОткрытьИлиСоздать);
		Попытка
			Ответ = ОбработатьПакетШК(Пакет, Корень);
		Исключение
			Поток.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		Поток.Закрыть();
		Возврат Ответ;
	Исключение
		ЗаписьЖурналаРегистрации("ТБК.ОбменШтрихкодами", УровеньЖурналаРегистрации.Ошибка,
			, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("Success,Error", Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ОбработатьПакетШК(Пакет, Корень)
	Поколение = 0;
	Для Каждого Каталог Из НайтиФайлы(Корень, "run-*", Ложь) Цикл
		Если Каталог.ЭтоКаталог() Тогда
			Поколение = Макс(Поколение, Число(Сред(Каталог.Имя, 5)));
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Stage = "status" Тогда
		Возврат Новый Структура("Success,Generation", Истина, Поколение);
	КонецЕсли;
	Если Пакет.Generation < 1 Или Пакет.Generation <> Цел(Пакет.Generation)
		Или Пакет.Page < 1 Или Пакет.Page <> Цел(Пакет.Page)
		Или Пакет.Pages < 1 Или Пакет.Pages <> Цел(Пакет.Pages)
		Или Пакет.Total < 0 Или Пакет.Total <> Цел(Пакет.Total)
		Или ТипЗнч(Пакет.Rows) <> Тип("Массив") Или Пакет.Rows.Количество() > 3000 Тогда
		ВызватьИсключение "Неверные границы пакета ШК.";
	КонецЕсли;
	Если Пакет.Stage <> ?(Пакет.Page <= Пакет.Pages, "data", "cleanup")
		Или (Пакет.Stage = "cleanup" И Пакет.Rows.Количество() > 0)
		Или (Пакет.Stage = "data" И Пакет.Rows.Количество() = 0 И (Пакет.Total <> 0 Или Пакет.Pages <> 1)) Тогда
		ВызватьИсключение "Неверный этап передачи ШК.";
	КонецЕсли;
	ИдСнимка = Строка(Новый УникальныйИдентификатор(Пакет.SnapshotId));
	КаталогОбмена = Корень + "run-" + Формат(Пакет.Generation, "ЧГ=0") + "\";
	Если Пакет.Generation = Поколение + 1 И Пакет.Page = 1 Тогда
		СоздатьКаталог(КаталогОбмена);
	ИначеЕсли Пакет.Generation <> Поколение Тогда
		ВызватьИсключение "Поколение обмена изменилось. Начните новую передачу из УТ.";
	КонецЕсли;
	Префикс = КаталогОбмена + Формат(Пакет.Page, "ЧГ=0");
	Если Пакет.Page = 1 Тогда
		Ответ = Новый Структура("Success,SnapshotId,Generation,Page,Pages,Total,Done", Истина, ИдСнимка,
			Пакет.Generation, 0, Пакет.Pages, Пакет.Total, Ложь);
		Ответ.Вставить("SourceRows", 0);
		Ответ.Вставить("SkippedRows", 0);
		Ответ.Вставить("SkippedOwners", 0);
		Ответ.Вставить("SkippedCardRows", 0);
		Ответ.Вставить("CreatedUnits", 0);
		Ответ.Вставить("CreatedPackages", 0);
		Ответ.Вставить("Examples", Новый Массив);
	Иначе
		Ответ = ЗначениеИзФайла(КаталогОбмена + Формат(Пакет.Page - 1, "ЧГ=0") + ".ack");
		Если Ответ.Done Или Ответ.SnapshotId <> ИдСнимка Или Ответ.Total <> Пакет.Total Или Ответ.Pages <> Пакет.Pages Тогда
			ВызватьИсключение "Пакет не соответствует предыдущему подтверждению.";
		КонецЕсли;
	КонецЕсли;
	Тело = ТБК_WS.СтруктураВjson(Пакет);
	ФайлЗапроса = Новый Файл(Префикс + ".request");
	Если ФайлЗапроса.Существует() Тогда
		Если ЗначениеИзФайла(Префикс + ".request") <> Тело Тогда
			ВызватьИсключение "Для этого номера уже получен другой пакет.";
		КонецЕсли;
		ФайлПодтверждения = Новый Файл(Префикс + ".ack");
		Если ФайлПодтверждения.Существует() Тогда
			Возврат ЗначениеИзФайла(Префикс + ".ack");
		КонецЕсли;
	Иначе
		СохранитьФайлОбменаШК(Префикс + ".request", Тело);
	КонецЕсли;

	Ответ.Page = Пакет.Page;
	Если Пакет.Stage = "data" Тогда
		Ответ.SourceRows = Ответ.SourceRows + Пакет.Rows.Количество();
		Если Ответ.SourceRows > Пакет.Total Или (Пакет.Page = Пакет.Pages И Ответ.SourceRows <> Пакет.Total) Тогда
			ВызватьИсключение "Число строк УТ отличается от объявленного.";
		КонецЕсли;
		ПрименитьСтрокиПакетаШК(Пакет.Rows, Префикс, Ответ);
	Иначе
		ПрименитьОчисткуПакетаШК(КаталогОбмена, Пакет, Ответ);
	КонецЕсли;
	СохранитьФайлОбменаШК(Префикс + ".ack", Ответ);
	Возврат Ответ;
КонецФункции

// Сначала закрываем временный файл в том же каталоге. Читателю доступен только готовый файл.
Процедура СохранитьФайлОбменаШК(Имя, Данные)
	ЗаписатьЗначениеОбменаШК(Имя + ".tmp", Данные);
	ПереместитьФайл(Имя + ".tmp", Имя);
КонецПроцедуры

Процедура ЗаписатьЗначениеОбменаШК(Имя, Данные)
	Если Не ЗначениеВФайл(Имя, Данные) Тогда
		ВызватьИсключение "Не удалось сохранить файл обмена ШК: " + Имя;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаблокироватьВладельцевШК(Пространство, Владельцы)
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Владелец");
	Для Каждого Владелец Из Владельцы Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Владелец = Владелец;
	КонецЦикла;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Пространство);
	Элемент.ИсточникДанных = Таблица;
	Элемент.ИспользоватьИзИсточникаДанных("Владелец", "Владелец");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ШтрихкодыВладельцевПакета(Владельцы)
	Запрос = Новый Запрос("ВЫБРАТЬ ШК.Владелец, ШК.Штрихкод, ШК.ТипШтрихкода, ШК.Характеристика,
	| ШК.Упаковка, ШК.ПредставлениеШтрихкода ИЗ РегистрСведений.Штрихкоды КАК ШК
	| ГДЕ ШК.Владелец В (&Владельцы)");
	Запрос.УстановитьПараметр("Владельцы", Владельцы);
	Выборка = Запрос.Выполнить().Выбрать();
	ПоВладельцам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Привязки = ПоВладельцам.Получить(Выборка.Владелец);
		Если Привязки = Неопределено Тогда
			Привязки = Новый Соответствие;
			ПоВладельцам.Вставить(Выборка.Владелец, Привязки);
		КонецЕсли;
		Привязки.Вставить(КлючШКВладельца(Выборка), Выборка.ПредставлениеШтрихкода);
	КонецЦикла;
	Возврат ПоВладельцам;
КонецФункции

Функция СовпадаютШКВладельца(Текущие, Ожидаемые)
	Если Текущие = Неопределено Или Текущие.Количество() <> Ожидаемые.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Привязка Из Текущие Цикл
		Если Ожидаемые.Получить(Привязка.Ключ) <> Привязка.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ПрименитьСтрокиПакетаШК(Строки, Префикс, Ответ)
	Группы = СтрокиСнимкаПоВладельцам(Строки);
	Владельцы = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		СтрокаУТ = Группа.Значение[0];
		Если СтрокаУТ.OwnerType = "Номенклатура" Тогда
			Менеджер = Справочники.Номенклатура;
		ИначеЕсли СтрокаУТ.OwnerType = "ИнформационныеКарты" Тогда
			Менеджер = Справочники.ИнформационныеКарты;
		Иначе
			ВызватьИсключение "Неизвестный тип владельца ШК.";
		КонецЕсли;
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаУТ.OwnerId));
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			ВызватьИсключение "Пустая ссылка владельца.";
		КонецЕсли;
		Владельцы.Добавить(Ссылка);
	КонецЦикла;
	// В перечне остаются и пропущенные владельцы. Их существующие ШК должны пережить очистку.
	ЗаписатьЗначениеОбменаШК(Префикс + ".owners", Владельцы);
	Если Владельцы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьВладельцевШК("РегистрСведений.Штрихкоды", Владельцы);
		Индексы = ИндексыСверки(Владельцы);
		Текущие = ШтрихкодыВладельцевПакета(Владельцы);
		Ожидаемые = Новый Соответствие;
		Для Каждого Группа Из Группы Цикл
			ЗаписатьШтрихкодыВладельца(Группа.Значение, Индексы, Ожидаемые, Ответ, Текущие);
		КонецЦикла;
		ПроверитьШтрихкодыПослеЗаписи(Ожидаемые, Владельцы);
		// После сбоя между COMMIT и .ack повтор увидит уже созданные единицы и упаковки.
		// Сохраняем плановые счётчики перед фиксацией, чтобы явно отметить неоднозначный результат.
		ФайлСчетчиков = Новый Файл(Префикс + ".counts");
		Если ФайлСчетчиков.Существует() Тогда
			Плановые = ЗначениеИзФайла(Префикс + ".counts");
			Если Плановые.CreatedPackages <> Ответ.CreatedPackages Или Плановые.CreatedUnits <> Ответ.CreatedUnits Тогда
				Ответ.Вставить("CreationCountsUncertain", Истина);
			КонецЕсли;
		Иначе
			СохранитьФайлОбменаШК(Префикс + ".counts", Новый Структура("CreatedPackages,CreatedUnits",
				Ответ.CreatedPackages, Ответ.CreatedUnits));
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ПрименитьОчисткуПакетаШК(КаталогОбмена, Пакет, Ответ)
	ИмяПлана = КаталогОбмена + "cleanup.plan";
	ФайлПлана = Новый Файл(ИмяПлана);
	Если Не ФайлПлана.Существует() Тогда
		ЧислоПорций = ПодготовитьОчисткуШК(КаталогОбмена, Пакет.Pages);
		СохранитьФайлОбменаШК(ИмяПлана, ЧислоПорций);
	КонецЕсли;
	ЧислоПорций = ЗначениеИзФайла(ИмяПлана);
	Номер = Пакет.Page - Пакет.Pages;
	Если Номер <= ЧислоПорций Тогда
		Ключи = ЗначениеИзФайла(КаталогОбмена + "clean-" + Формат(Номер, "ЧГ=0") + ".keys");
		Владельцы = Новый Массив;
		Для Каждого Ключ Из Ключи Цикл
			Владельцы.Добавить(Ключ.Владелец);
		КонецЦикла;
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьВладельцевШК("РегистрСведений.Штрихкоды", Владельцы);
			Для Каждого Ключ Из Ключи Цикл
				Запись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Ключ);
				Запись.Прочитать();
				Если Запись.Выбран() Тогда
					Запись.Удалить();
				КонецЕсли;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	Ответ.Done = Номер >= ЧислоПорций;
	Если Ответ.Done Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РегистрСведений.Штрихкоды");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Ответ.Вставить("RetailRows", Выборка.Всего);
	КонецЕсли;
КонецПроцедуры

Функция ПодготовитьОчисткуШК(КаталогОбмена, Страниц)
	Присутствуют = Новый Соответствие;
	Для Номер = 1 По Страниц Цикл
		Владельцы = ЗначениеИзФайла(КаталогОбмена + Формат(Номер, "ЧГ=0") + ".owners");
		Для Каждого Владелец Из Владельцы Цикл
			Присутствуют.Вставить(Владелец, Истина);
		КонецЦикла;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ ШК.Штрихкод, ШК.Владелец, ШК.Характеристика, ШК.Упаковка, ШК.ТипШтрихкода
	|ИЗ РегистрСведений.Штрихкоды КАК ШК");
	Выборка = Запрос.Выполнить().Выбрать();
	Ключи = Новый Массив;
	ЧислоПорций = 0;
	Пока Выборка.Следующий() Цикл
		Если Присутствуют.Получить(Выборка.Владелец) = Неопределено Тогда
			Ключ = Новый Структура("Штрихкод,Владелец,Характеристика,Упаковка,ТипШтрихкода");
			ЗаполнитьЗначенияСвойств(Ключ, Выборка);
			Ключи.Добавить(Ключ);
			Если Ключи.Количество() = 3000 Тогда
				ЧислоПорций = ЧислоПорций + 1;
				ЗаписатьЗначениеОбменаШК(КаталогОбмена + "clean-" + Формат(ЧислоПорций, "ЧГ=0") + ".keys", Ключи);
				Ключи.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() > 0 Тогда
		ЧислоПорций = ЧислоПорций + 1;
		ЗаписатьЗначениеОбменаШК(КаталогОбмена + "clean-" + Формат(ЧислоПорций, "ЧГ=0") + ".keys", Ключи);
	КонецЕсли;
	Возврат ЧислоПорций;
КонецФункции

// Заменяет штрихкоды по полному снимку УТ. При ошибке сопоставления сохраняет весь набор владельца.
// Параметры:
//   СнимокУТ - Структура - Total (число исходных строк), Rows (полный массив строк УТ).
// Возвращаемое значение:
//   Структура - Success, SourceRows, RetailRows (фактическое число записей), SkippedOwners, SkippedRows,
//     SkippedCardRows, CreatedUnits, CreatedPackages и Examples (до 100 причин пропуска). При ошибке всего пакета — Success = Ложь и Error.
Функция ReplaceBarcodeSnapshot(СнимокУТ) Экспорт

	Попытка
		Если ТипЗнч(СнимокУТ.Rows) <> Тип("Массив") Или ТипЗнч(СнимокУТ.Total) <> Тип("Число")
			Или СнимокУТ.Total <> СнимокУТ.Rows.Количество() Тогда
			ВызватьИсключение "Количество строк снимка не подтверждено.";
		КонецЕсли;
		СтрокиПоВладельцам = СтрокиСнимкаПоВладельцам(СнимокУТ.Rows);
		РезультатЗагрузки = Новый Структура(
			"Success,SourceRows,RetailRows,SkippedCardRows,SkippedOwners,SkippedRows,Examples",
			Истина, СнимокУТ.Total, 0, 0, 0, 0, Новый Массив);
		РезультатЗагрузки.Вставить("CreatedUnits", 0);
		РезультатЗагрузки.Вставить("CreatedPackages", 0);

		НачатьТранзакцию();
		Попытка
			БлокировкаЗагрузки = Новый БлокировкаДанных;
			ЭлементБлокировкиРегистра = БлокировкаЗагрузки.Добавить("РегистрСведений.Штрихкоды");
			ЭлементБлокировкиРегистра.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировкиСправочника = БлокировкаЗагрузки.Добавить("Справочник.БазовыеЕдиницыИзмерения");
			ЭлементБлокировкиСправочника.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировкиСправочника = БлокировкаЗагрузки.Добавить("Справочник.УпаковкиНоменклатуры");
			ЭлементБлокировкиСправочника.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаЗагрузки.Заблокировать();
			СоответствияРозницы = ИндексыСверки();
			// Для записанного владельца храним ожидаемые ШК, для пропущенного — Ложь.
			ОжидаемыеШтрихкодыПоВладельцам = Новый Соответствие;
			Для Каждого ГруппаВладельца Из СтрокиПоВладельцам Цикл
				ЗаписатьШтрихкодыВладельца(ГруппаВладельца.Значение, СоответствияРозницы,
					ОжидаемыеШтрихкодыПоВладельцам, РезультатЗагрузки);
			КонецЦикла;
			УдалитьШтрихкодыОтсутствующихВладельцев(ОжидаемыеШтрихкодыПоВладельцам);
			РезультатЗагрузки.RetailRows = ПроверитьШтрихкодыПослеЗаписи(ОжидаемыеШтрихкодыПоВладельцам);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		Возврат Новый Структура("Success,Error", Ложь, ОписаниеОшибки());
	КонецПопытки;
	Возврат РезультатЗагрузки;

КонецФункции

Функция СтрокиСнимкаПоВладельцам(СтрокиСнимка)
	СтрокиПоВладельцам = Новый Соответствие;
	Для Каждого СтрокаСнимка Из СтрокиСнимка Цикл
		Если ПустаяСтрока(СтрокаСнимка.OwnerId) Тогда
			ВызватьИсключение "Пустой UUID владельца штрихкода.";
		КонецЕсли;
		Если ТипЗнч(СтрокаСнимка.Barcode) <> Тип("Строка") Или ТипЗнч(СтрокаСнимка.Presentation) <> Тип("Строка") Тогда
			ВызватьИсключение "Штрихкод и его представление должны быть строками.";
		КонецЕсли;
		КлючВладельца = СтрокаСнимка.OwnerType + "/" + НРег(СтрокаСнимка.OwnerId);
		СтрокиВладельца = СтрокиПоВладельцам.Получить(КлючВладельца);
		Если СтрокиВладельца = Неопределено Тогда
			СтрокиВладельца = Новый Массив;
			СтрокиПоВладельцам.Вставить(КлючВладельца, СтрокиВладельца);
		КонецЕсли;
		СтрокиВладельца.Добавить(СтрокаСнимка);
	КонецЦикла;
	Возврат СтрокиПоВладельцам;
КонецФункции

Процедура ЗаписатьШтрихкодыВладельца(СтрокиВладельца, СоответствияРозницы,
		ОжидаемыеШтрихкодыПоВладельцам, РезультатЗагрузки, ТекущиеПоВладельцам = Неопределено)
	СтрокаСнимка = СтрокиВладельца[0];
	ИдентификаторВладельца = НРег(СтрокаСнимка.OwnerId);
	ПричинаПропуска = "";
	ЭтоНоменклатура = СтрокаСнимка.OwnerType = "Номенклатура";
	ИдентификаторВладельцаУпаковок = Неопределено;
	Если ЭтоНоменклатура Тогда
		СправочникВладельца = Справочники.Номенклатура;
		ИдентификаторВладельцаУпаковок = СоответствияРозницы.ВладельцыУпаковокПоТоварам.Получить(
			ИдентификаторВладельца);
		Если ИдентификаторВладельцаУпаковок = Неопределено Тогда
			ПричинаПропуска = "Не найдена номенклатура.";
		КонецЕсли;
	ИначеЕсли СтрокаСнимка.OwnerType = "ИнформационныеКарты" Тогда
		СправочникВладельца = Справочники.ИнформационныеКарты;
		Если СоответствияРозницы.ИдентификаторыКарт.Получить(ИдентификаторВладельца) = Неопределено Тогда
			ПричинаПропуска = "Не найдена информационная карта.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Неизвестный тип владельца: " + СтрокаСнимка.OwnerType;
	КонецЕсли;

	СсылкаНаВладельца = СправочникВладельца.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторВладельца));
	Если ПричинаПропуска = "" Тогда
		НаборШтрихкодов = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		НаборШтрихкодов.Отбор.Владелец.Установить(СсылкаНаВладельца);
		ПредставленияПоКлючу = Новый Соответствие;
		НовыеУпаковки = Новый Соответствие;
		Для Каждого СтрокаСнимка Из СтрокиВладельца Цикл
			ДанныеШтрихкода = ПривязкаСтрокиУТ(СтрокаСнимка, СоответствияРозницы, СсылкаНаВладельца,
				ИдентификаторВладельцаУпаковок, НовыеУпаковки, РезультатЗагрузки, ПричинаПропуска);
			Если ПричинаПропуска <> "" Тогда
				Прервать;
			КонецЕсли;
			КлючПривязки = КлючШКВладельца(ДанныеШтрихкода);
			СохраненноеПредставление = ПредставленияПоКлючу.Получить(КлючПривязки);
			Если СохраненноеПредставление = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НаборШтрихкодов.Добавить(), ДанныеШтрихкода);
				ПредставленияПоКлючу.Вставить(КлючПривязки, СтрокаСнимка.Presentation);
			ИначеЕсли СохраненноеПредставление <> СтрокаСнимка.Presentation Тогда
				ПричинаПропуска = "Разные представления одной привязки.";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПричинаПропуска = "" Тогда
			Для Каждого НоваяУпаковка Из НовыеУпаковки Цикл
				НоваяУпаковка.Значение.Записать();
				СоответствияРозницы.УпаковкиПоПараметрам.Вставить(НоваяУпаковка.Ключ, ИдСсылки(НоваяУпаковка.Значение.Ссылка));
				РезультатЗагрузки.CreatedPackages = РезультатЗагрузки.CreatedPackages + 1;
			КонецЦикла;
			Если ТекущиеПоВладельцам = Неопределено Или Не СовпадаютШКВладельца(
				ТекущиеПоВладельцам.Получить(СсылкаНаВладельца), ПредставленияПоКлючу) Тогда
				НаборШтрихкодов.Записать(Истина);
			КонецЕсли;
			ОжидаемыеШтрихкодыПоВладельцам.Вставить(СсылкаНаВладельца, ПредставленияПоКлючу);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОжидаемыеШтрихкодыПоВладельцам.Вставить(СсылкаНаВладельца, Ложь);
	РезультатЗагрузки.SkippedOwners = РезультатЗагрузки.SkippedOwners + 1;
	РезультатЗагрузки.SkippedRows = РезультатЗагрузки.SkippedRows + СтрокиВладельца.Количество();
	Если Не ЭтоНоменклатура Тогда
		РезультатЗагрузки.SkippedCardRows = РезультатЗагрузки.SkippedCardRows + СтрокиВладельца.Количество();
	КонецЕсли;
	Если РезультатЗагрузки.Examples.Количество() < 100 Тогда
		РезультатЗагрузки.Examples.Добавить(Новый Структура("Barcode,OwnerId,Reason,UnitName,UnitCode,UnitFactor",
			СтрокаСнимка.Barcode, СтрокаСнимка.OwnerId, ПричинаПропуска,
			СтрокаСнимка.UnitName, СтрокаСнимка.UnitCode, СтрокаСнимка.UnitFactor));
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьШтрихкодыОтсутствующихВладельцев(ВладельцыСнимка)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ШК.Владелец ИЗ РегистрСведений.Штрихкоды КАК ШК");
	ВыборкаВладельцевРозницы = Запрос.Выполнить().Выбрать();
	Пока ВыборкаВладельцевРозницы.Следующий() Цикл
		Если ВладельцыСнимка.Получить(ВыборкаВладельцевРозницы.Владелец) = Неопределено Тогда
			ПустойНаборШтрихкодов = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
			ПустойНаборШтрихкодов.Отбор.Владелец.Установить(ВыборкаВладельцевРозницы.Владелец);
			ПустойНаборШтрихкодов.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПроверитьШтрихкодыПослеЗаписи(ОжидаемыеШтрихкодыПоВладельцам, ВладельцыПакета = Неопределено)
	Запрос = Новый Запрос("ВЫБРАТЬ ШК.Штрихкод, ШК.Владелец, ШК.ТипШтрихкода, ШК.Характеристика,
	| ШК.Упаковка, ШК.ПредставлениеШтрихкода ИЗ РегистрСведений.Штрихкоды КАК ШК");
	Если ВладельцыПакета <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " ГДЕ ШК.Владелец В (&Владельцы)";
		Запрос.УстановитьПараметр("Владельцы", ВладельцыПакета);
	КонецЕсли;
	ВыборкаШтрихкодовРозницы = Запрос.Выполнить().Выбрать();
	КоличествоЗаписейРегистра = 0;
	Пока ВыборкаШтрихкодовРозницы.Следующий() Цикл
		КоличествоЗаписейРегистра = КоличествоЗаписейРегистра + 1;
		ОжидаемыеПредставления = ОжидаемыеШтрихкодыПоВладельцам.Получить(ВыборкаШтрихкодовРозницы.Владелец);
		Если ОжидаемыеПредставления = Ложь Тогда
			Продолжить;
		КонецЕсли;
		КлючПривязки = КлючШКВладельца(ВыборкаШтрихкодовРозницы);
		Если ОжидаемыеПредставления = Неопределено
			Или ОжидаемыеПредставления.Получить(КлючПривязки) <> ВыборкаШтрихкодовРозницы.ПредставлениеШтрихкода Тогда
			ВызватьИсключение "После записи обнаружено расхождение по ШК " + ВыборкаШтрихкодовРозницы.Штрихкод;
		КонецЕсли;
		ОжидаемыеПредставления.Удалить(КлючПривязки);
	КонецЦикла;
	Для Каждого ШтрихкодыВладельца Из ОжидаемыеШтрихкодыПоВладельцам Цикл
		Если ШтрихкодыВладельца.Значение <> Ложь И ШтрихкодыВладельца.Значение.Количество() > 0 Тогда
			ВызватьИсключение "После записи отсутствуют штрихкоды владельца " + Строка(ШтрихкодыВладельца.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат КоличествоЗаписейРегистра;
КонецФункции

Функция СсылкаШК(МенеджерСправочника, ИдентификаторОбъекта)
	Если ИдентификаторОбъекта = "" Тогда
		Возврат МенеджерСправочника.ПустаяСсылка();
	КонецЕсли;
	Возврат МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторОбъекта));
КонецФункции

// Владелец уже учтён в отборе набора и в ключе соответствия ожидаемых штрихкодов.
Функция КлючШКВладельца(ЗаписьШтрихкода)
	Возврат КлючСверки(ЗаписьШтрихкода.Штрихкод, ИдСсылки(ЗаписьШтрихкода.ТипШтрихкода),
		ИдСсылки(ЗаписьШтрихкода.Характеристика), ИдСсылки(ЗаписьШтрихкода.Упаковка));
КонецФункции

Функция КлючСверки(ПерваяЧасть, ВтораяЧасть, ТретьяЧасть = Неопределено, ЧетвертаяЧасть = Неопределено)
	ЧастиКлюча = Новый Массив;
	ЧастиКлюча.Добавить(ПерваяЧасть);
	ЧастиКлюча.Добавить(ВтораяЧасть);
	ЧастиКлюча.Добавить(ТретьяЧасть);
	ЧастиКлюча.Добавить(ЧетвертаяЧасть);
	Возврат ТБК_WS.СтруктураВjson(ЧастиКлюча);
КонецФункции

Функция ИдСсылки(СсылкаНаОбъект)
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(СсылкаНаОбъект.УникальныйИдентификатор());
КонецФункции

Процедура ДобавитьОднозначное(СоответствиеДляПоиска, КлючПоиска, ИдентификаторОбъекта)
	СохраненноеЗначение = СоответствиеДляПоиска.Получить(КлючПоиска);
	Если СохраненноеЗначение = Неопределено Или СохраненноеЗначение = ИдентификаторОбъекта Тогда
		СоответствиеДляПоиска.Вставить(КлючПоиска, ИдентификаторОбъекта);
	Иначе
		СоответствиеДляПоиска.Вставить(КлючПоиска, Ложь);
	КонецЕсли;
КонецПроцедуры

Функция ИндексыСверки(ВладельцыПакета = Неопределено)
	СоответствияРозницы = Новый Структура;
	СоответствияРозницы.Вставить("ВладельцыУпаковокПоТоварам", Новый Соответствие);
	СоответствияРозницы.Вставить("ИдентификаторыКарт", Новый Соответствие);
	СоответствияРозницы.Вставить("ТипыШтрихкодовПоИдентификатору", Новый Соответствие);
	СоответствияРозницы.Вставить("ВладельцыХарактеристик", Новый Соответствие);
	СоответствияРозницы.Вставить("ХарактеристикиПоВладельцуИНаименованию", Новый Соответствие);
	СоответствияРозницы.Вставить("ИдентификаторыЕдиниц", Новый Соответствие);
	СоответствияРозницы.Вставить("ЕдиницыПоКоду", Новый Соответствие);
	СоответствияРозницы.Вставить("УпаковкиПоПараметрам", Новый Соответствие);
	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка, Т.НаборУпаковок ИЗ Справочник.Номенклатура КАК Т");
	Если ВладельцыПакета <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " ГДЕ Т.Ссылка В (&Владельцы)";
		Запрос.УстановитьПараметр("Владельцы", ВладельцыПакета);
		ВладельцыУпаковок = Новый Массив;
	КонецЕсли;
	ВыборкаНоменклатуры = Запрос.Выполнить().Выбрать();
	Пока ВыборкаНоменклатуры.Следующий() Цикл
		ИдентификаторТовара = ИдСсылки(ВыборкаНоменклатуры.Ссылка);
		ИдентификаторВладельцаУпаковок = ИдентификаторТовара;
		Если ЗначениеЗаполнено(ВыборкаНоменклатуры.НаборУпаковок)
			И ВыборкаНоменклатуры.НаборУпаковок <> Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
			ИдентификаторВладельцаУпаковок = ИдСсылки(ВыборкаНоменклатуры.НаборУпаковок);
		КонецЕсли;
		Если ВладельцыПакета <> Неопределено Тогда
			ВладельцыУпаковок.Добавить(?(ИдентификаторВладельцаУпаковок = ИдентификаторТовара,
				ВыборкаНоменклатуры.Ссылка, ВыборкаНоменклатуры.НаборУпаковок));
		КонецЕсли;
		СоответствияРозницы.ВладельцыУпаковокПоТоварам.Вставить(ИдентификаторТовара, ИдентификаторВладельцаУпаковок);
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ К.Ссылка ИЗ Справочник.ИнформационныеКарты КАК К";
	Если ВладельцыПакета <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " ГДЕ К.Ссылка В (&Владельцы)";
	КонецЕсли;
	ВыборкаКарт = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКарт.Следующий() Цикл
		СоответствияРозницы.ИдентификаторыКарт.Вставить(ИдСсылки(ВыборкаКарт.Ссылка), Истина);
	КонецЦикла;
	// УТ передаёт UUID. Предопределённые типы в УТ 10.3 и Рознице имеют разные UUID.
	ИдентификаторыТиповУТ = Новый Структура;
	ИдентификаторыТиповУТ.Вставить("EAN13", "39fddca4-7cc4-49d4-a09d-9fe5517b4df6");
	ИдентификаторыТиповУТ.Вставить("EAN8", "52707714-e6da-40b1-bb9e-a70d03e5d651");
	ИдентификаторыТиповУТ.Вставить("EAN128", "692c0975-7c6c-4f09-8137-96393bae890c");
	ИдентификаторыТиповУТ.Вставить("CODE128", "ddc03064-37b8-4688-9401-07ac8346e621");
	ИдентификаторыТиповУТ.Вставить("CODE39", "f673c0e8-fae1-4b66-bbe1-012b9f51487b");
	Запрос.Текст = "ВЫБРАТЬ Т.Ссылка, Т.ИмяПредопределенныхДанных КАК Имя
	|ИЗ ПланВидовХарактеристик.ТипыШтрихкодов КАК Т";
	ВыборкаТиповШтрихкодов = Запрос.Выполнить().Выбрать();
	ТипыРозницыПоИмени = Новый Соответствие;
	Пока ВыборкаТиповШтрихкодов.Следующий() Цикл
		СоответствияРозницы.ТипыШтрихкодовПоИдентификатору.Вставить(
			ИдСсылки(ВыборкаТиповШтрихкодов.Ссылка), ВыборкаТиповШтрихкодов.Ссылка);
		Если ЗначениеЗаполнено(ВыборкаТиповШтрихкодов.Имя) Тогда
			ТипыРозницыПоИмени.Вставить(ВыборкаТиповШтрихкодов.Имя, ВыборкаТиповШтрихкодов.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТипШтрихкодаУТ Из ИдентификаторыТиповУТ Цикл
		СоответствияРозницы.ТипыШтрихкодовПоИдентификатору.Вставить(
			ТипШтрихкодаУТ.Значение, ТипыРозницыПоИмени.Получить(ТипШтрихкодаУТ.Ключ));
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ Х.Ссылка, Х.Владелец, Х.Наименование ИЗ Справочник.ХарактеристикиНоменклатуры КАК Х";
	Если ВладельцыПакета <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " ГДЕ Х.Владелец В (&Владельцы)";
	КонецЕсли;
	ВыборкаХарактеристик = Запрос.Выполнить().Выбрать();
	Пока ВыборкаХарактеристик.Следующий() Цикл
		ИдентификаторХарактеристики = ИдСсылки(ВыборкаХарактеристик.Ссылка);
		ИдентификаторВладельцаХарактеристики = ИдСсылки(ВыборкаХарактеристик.Владелец);
		СоответствияРозницы.ВладельцыХарактеристик.Вставить(
			ИдентификаторХарактеристики, ИдентификаторВладельцаХарактеристики);
		КлючПоискаХарактеристики = КлючСверки(ИдентификаторВладельцаХарактеристики, ВыборкаХарактеристик.Наименование);
		ДобавитьОднозначное(СоответствияРозницы.ХарактеристикиПоВладельцуИНаименованию,
			КлючПоискаХарактеристики, ИдентификаторХарактеристики);
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ Е.Ссылка, Е.Код ИЗ Справочник.БазовыеЕдиницыИзмерения КАК Е";
	ВыборкаЕдиниц = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЕдиниц.Следующий() Цикл
		ИдентификаторЕдиницы = ИдСсылки(ВыборкаЕдиниц.Ссылка);
		СоответствияРозницы.ИдентификаторыЕдиниц.Вставить(ИдентификаторЕдиницы, Истина);
		ДобавитьОднозначное(СоответствияРозницы.ЕдиницыПоКоду, СокрЛП(ВыборкаЕдиниц.Код), ИдентификаторЕдиницы);
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ У.Ссылка, У.Владелец, У.Наименование, У.ЕдиницаИзмерения, У.Коэффициент
	|ИЗ Справочник.УпаковкиНоменклатуры КАК У";
	Если ВладельцыПакета <> Неопределено Тогда
		Если ВладельцыУпаковок.Количество() > 0 Тогда
			ЗаблокироватьВладельцевШК("Справочник.УпаковкиНоменклатуры", ВладельцыУпаковок);
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + " ГДЕ У.Владелец В (&ВладельцыУпаковок)";
		Запрос.УстановитьПараметр("ВладельцыУпаковок", ВладельцыУпаковок);
	КонецЕсли;
	ВыборкаУпаковок = Запрос.Выполнить().Выбрать();
	Пока ВыборкаУпаковок.Следующий() Цикл
		КлючПоискаУпаковки = КлючСверки(ИдСсылки(ВыборкаУпаковок.Владелец), СокрЛП(ВыборкаУпаковок.Наименование),
			ИдСсылки(ВыборкаУпаковок.ЕдиницаИзмерения), ВыборкаУпаковок.Коэффициент);
		ДобавитьОднозначное(СоответствияРозницы.УпаковкиПоПараметрам,
			КлючПоискаУпаковки, ИдСсылки(ВыборкаУпаковок.Ссылка));
	КонецЦикла;
	Возврат СоответствияРозницы;
КонецФункции

Функция ПривязкаСтрокиУТ(СтрокаСнимка, СоответствияРозницы, СсылкаНаВладельца,
		ИдентификаторВладельцаУпаковок, НовыеУпаковки, РезультатЗагрузки, ПричинаПропуска)
	ТипШтрихкодаРозницы = СоответствияРозницы.ТипыШтрихкодовПоИдентификатору.Получить(СтрокаСнимка.BarcodeTypeId);
	Если ТипШтрихкодаРозницы = Неопределено Тогда
		ПричинаПропуска = "Не найден тип штрихкода Розницы для UUID из УТ: " + Строка(СтрокаСнимка.BarcodeTypeId);
		Возврат Неопределено;
	КонецЕсли;
	ИдентификаторХарактеристики = "";
	Если СтрокаСнимка.OwnerType = "Номенклатура" И УчетХарактеристикСнимка(СтрокаСнимка.UsesVariants) Тогда
		Если СтрокаСнимка.VariantId <> ""
			И СоответствияРозницы.ВладельцыХарактеристик.Получить(СтрокаСнимка.VariantId) = СтрокаСнимка.OwnerId Тогда
			ИдентификаторХарактеристики = СтрокаСнимка.VariantId;
		Иначе
			НаименованиеХарактеристики = ?(СтрокаСнимка.VariantId = "", "<Не заполнено>", СтрокаСнимка.VariantName);
			КлючПоискаХарактеристики = КлючСверки(СтрокаСнимка.OwnerId, НаименованиеХарактеристики);
			ИдентификаторХарактеристики = СоответствияРозницы.ХарактеристикиПоВладельцуИНаименованию.Получить(
				КлючПоискаХарактеристики);
			Если ТипЗнч(ИдентификаторХарактеристики) <> Тип("Строка") Тогда
				ПричинаПропуска = "Не сопоставлена характеристика.";
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Упаковка = УпаковкаИзСнимкаУТ(СтрокаСнимка, СоответствияРозницы, СсылкаНаВладельца,
		ИдентификаторВладельцаУпаковок, НовыеУпаковки, РезультатЗагрузки, ПричинаПропуска);
	Если ПричинаПропуска <> "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДанныеШтрихкода = Новый Структура;
	ДанныеШтрихкода.Вставить("Штрихкод", СтрокаСнимка.Barcode);
	ДанныеШтрихкода.Вставить("ПредставлениеШтрихкода", СтрокаСнимка.Presentation);
	ДанныеШтрихкода.Вставить("Владелец", СсылкаНаВладельца);
	ДанныеШтрихкода.Вставить("ТипШтрихкода", ТипШтрихкодаРозницы);
	ДанныеШтрихкода.Вставить("Характеристика",
		СсылкаШК(Справочники.ХарактеристикиНоменклатуры, ИдентификаторХарактеристики));
	ДанныеШтрихкода.Вставить("Упаковка", Упаковка);
	Возврат ДанныеШтрихкода;
КонецФункции

Функция УчетХарактеристикСнимка(УчетХарактеристикУТ)
	Если ТипЗнч(УчетХарактеристикУТ) = Тип("Булево") Тогда
		Возврат УчетХарактеристикУТ;
	КонецЕсли;
	// Ранее отправленные снимки могут содержать строковое представление признака.
	Если ТипЗнч(УчетХарактеристикУТ) = Тип("Строка") Тогда
		ТекстПризнака = НРег(СокрЛП(УчетХарактеристикУТ));
		Если ТекстПризнака = "да" Или ТекстПризнака = "true"
			Или ТекстПризнака = "истина" Или ТекстПризнака = "1" Тогда
			Возврат Истина;
		ИначеЕсли ТекстПризнака = "нет" Или ТекстПризнака = "false"
			Или ТекстПризнака = "ложь" Или ТекстПризнака = "0" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение "Неизвестное значение UsesVariants: " + Строка(УчетХарактеристикУТ);
КонецФункции

Функция УпаковкаИзСнимкаУТ(СтрокаСнимка, СоответствияРозницы, Номенклатура,
		ИдентификаторВладельцаУпаковок, НовыеУпаковки, РезультатЗагрузки, ПричинаПропуска)

	Если СтрокаСнимка.UnitId = "" Тогда
		Возврат Справочники.УпаковкиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Если СтрокаСнимка.OwnerType <> "Номенклатура" Или СтрокаСнимка.UnitOwnerId <> СтрокаСнимка.OwnerId Тогда
		ПричинаПропуска = "Единица УТ не принадлежит товару.";
		Возврат Неопределено;
	КонецЕсли;
	Коэффициент = СтрокаСнимка.UnitFactor;
	Если ТипЗнч(Коэффициент) = Тип("Строка") Тогда
		Попытка
			Коэффициент = XMLЗначение(Тип("Число"), СтрЗаменить(СокрЛП(Коэффициент), ",", "."));
		Исключение
			Коэффициент = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Коэффициент) <> Тип("Число") Или Коэффициент <= 0 Тогда
		ПричинаПропуска = "Некорректный коэффициент упаковки: " + Строка(СтрокаСнимка.UnitFactor);
		Возврат Неопределено;
	КонецЕсли;
	Если Коэффициент = 1 Тогда
		Возврат Справочники.УпаковкиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	ИдентификаторЕдиницы = СтрокаСнимка.ClassifierUnitId;
	Если ИдентификаторЕдиницы = "" Тогда
		ИдентификаторЕдиницы = СтрокаСнимка.BaseUnitId;
	КонецЕсли;
	Если ИдентификаторЕдиницы = "" Тогда
		ПричинаПропуска = "В УТ не указана единица классификатора или базовая единица товара.";
		Возврат Неопределено;
	КонецЕсли;

	НаименованиеУпаковки = СокрЛП(СтрокаСнимка.UnitName);
	Если ПустаяСтрока(НаименованиеУпаковки) Тогда
		ПричинаПропуска = "В УТ не заполнено наименование упаковки.";
		Возврат Неопределено;
	КонецЕсли;
	Если СоответствияРозницы.ИдентификаторыЕдиниц.Получить(ИдентификаторЕдиницы) = Неопределено Тогда
		КодЕдиницы = СокрЛП(Строка(СтрокаСнимка.UnitCode));
		ИдентификаторЕдиницы = СоответствияРозницы.ЕдиницыПоКоду.Получить(КодЕдиницы);
		Если ИдентификаторЕдиницы = Ложь Тогда
			ПричинаПропуска = "Несколько единиц Розницы с кодом " + КодЕдиницы;
			Возврат Неопределено;
		КонецЕсли;
		Если ИдентификаторЕдиницы = Неопределено Тогда
			Если ПустаяСтрока(КодЕдиницы) Или СтрДлина(КодЕдиницы) > 4 Или СтрНайти(КодЕдиницы, ",") > 0 Тогда
				ПричинаПропуска = "В УТ не указан однозначный код ОКЕИ.";
				Возврат Неопределено;
			КонецЕсли;
			ЕдиницыПоКоду = Справочники.БазовыеЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(КодЕдиницы);
			ЕдиницаРозницы = ЕдиницыПоКоду.Получить(КодЕдиницы);
			Если Не ЗначениеЗаполнено(ЕдиницаРозницы) Тогда
				Если Не СтрокаСнимка.Свойство("ClassifierUnitName")
					Или Не ЗначениеЗаполнено(СтрокаСнимка.ClassifierUnitName) Тогда
					ПричинаПропуска = "Единица отсутствует в ОКЕИ, нет наименования из УТ: " + КодЕдиницы;
					Возврат Неопределено;
				КонецЕсли;
				НоваяЕдиница = Справочники.БазовыеЕдиницыИзмерения.СоздатьЭлемент();
				НоваяЕдиница.Код = КодЕдиницы;
				НоваяЕдиница.Наименование = СтрокаСнимка.ClassifierUnitName;
				НоваяЕдиница.Записать();
				ЕдиницаРозницы = НоваяЕдиница.Ссылка;
			КонецЕсли;
			ИдентификаторЕдиницы = ИдСсылки(ЕдиницаРозницы);
			РезультатЗагрузки.CreatedUnits = РезультатЗагрузки.CreatedUnits + 1;
			СоответствияРозницы.ИдентификаторыЕдиниц.Вставить(ИдентификаторЕдиницы, Истина);
			СоответствияРозницы.ЕдиницыПоКоду.Вставить(КодЕдиницы, ИдентификаторЕдиницы);
		КонецЕсли;
	КонецЕсли;

	КлючУпаковки = КлючСверки(ИдентификаторВладельцаУпаковок, НаименованиеУпаковки, ИдентификаторЕдиницы, Коэффициент);
	ИдентификаторУпаковки = СоответствияРозницы.УпаковкиПоПараметрам.Получить(КлючУпаковки);
	Если ИдентификаторУпаковки = Ложь Тогда
		ПричинаПропуска = "Найдено несколько упаковок: " + НаименованиеУпаковки;
		Возврат Неопределено;
	ИначеЕсли ИдентификаторУпаковки <> Неопределено Тогда
		Возврат СсылкаШК(Справочники.УпаковкиНоменклатуры, ИдентификаторУпаковки);
	КонецЕсли;
	ОбъектУпаковки = НовыеУпаковки.Получить(КлючУпаковки);
	Если ОбъектУпаковки <> Неопределено Тогда
		Возврат ОбъектУпаковки.ПолучитьСсылкуНового();
	КонецЕсли;
	НаборУпаковок = Номенклатура.НаборУпаковок;
	Если Не ЗначениеЗаполнено(НаборУпаковок) Тогда
		ПричинаПропуска = "У товара не настроен набор упаковок.";
		Возврат Неопределено;
	КонецЕсли;
	ВладелецУпаковки = НаборУпаковок;
	Если НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
		Если Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
			ПричинаПропуска = "Индивидуальная упаковка разрешена только для товара.";
			Возврат Неопределено;
		КонецЕсли;
		ВладелецУпаковки = Номенклатура;
	КонецЕсли;
	СсылкаУпаковки = Справочники.УпаковкиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор());
	ОбъектУпаковки = Справочники.УпаковкиНоменклатуры.СоздатьЭлемент();
	ОбъектУпаковки.УстановитьСсылкуНового(СсылкаУпаковки);
	ОбъектУпаковки.Владелец = ВладелецУпаковки;
	ОбъектУпаковки.Наименование = НаименованиеУпаковки;
	ОбъектУпаковки.ЕдиницаИзмерения = СсылкаШК(Справочники.БазовыеЕдиницыИзмерения, ИдентификаторЕдиницы);
	ОбъектУпаковки.Коэффициент = Коэффициент;
	НовыеУпаковки.Вставить(КлючУпаковки, ОбъектУпаковки);
	Возврат СсылкаУпаковки;
КонецФункции
