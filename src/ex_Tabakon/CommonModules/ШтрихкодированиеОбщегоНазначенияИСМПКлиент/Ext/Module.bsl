
// Определяет, что отсканированная марка не может быть продана, и подготавливает замену товара на БК.
//
// Типовая вызывает ДополнительныеПроверкиПередЗавершениемОбработкиШтрихкода непосредственно перед тем,
// как выбрать форму для показа кассиру:
//  - ИнтеграцияТСПИоТКлиент.ЗавершитьПроверкуШтрихкодаПослеПолученияДанныхТСПИоТ - после ответа ТС ПИоТ;
//  - ШтрихкодированиеОбщегоНазначенияИСКлиент.ЗавершитьОбработкуШтрихкода - перед открытием формы уточнения.
// Изменения РезультатОбработкиШтрихкода, сделанные здесь, сохраняются в обоих случаях.
//
// Признак ОткрытьФормуВводаКодаМаркировки уводит типовой сценарий на форму считывания кода маркировки,
// которая в расширении подменена на подбор по БК
// (см. ШтрихкодированиеИСКлиент.ТБКОткрытьФормуСчитыванияКодаМаркировки).
//
// https://jira.tabkn.ru/browse/ROZ-14
//
&После("ДополнительныеПроверкиПередЗавершениемОбработкиШтрихкода")
Процедура ТБКДополнительныеПроверкиПередЗавершениемОбработкиШтрихкода(Форма, ПараметрыСканирования, РезультатОбработкиШтрихкода)

	Если Не ТБКТребуетсяПредложитьЗаменуНаБК(РезультатОбработкиШтрихкода) Тогда
		Возврат;
	КонецЕсли;

	ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;

	GTIN = "";
	ДанныеШтрихкода.Свойство("GTIN", GTIN);

	ПараметрыЗамены = ОбщегоНазначенияВызовСервера.ТБКПараметрыЗаменыНаБК(
		ДанныеШтрихкода.Номенклатура,
		ДанныеШтрихкода.ВидПродукции,
		Строка(GTIN));

	Если Не ПараметрыЗамены.ЗаменаВозможна Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЗамены.Комментарий = НСтр("ru = 'Марка не прошла проверку. Пробейте товар по БК.'");
	ПараметрыЗамены.Вставить("МаркаПолная", ТБКПолныйКодМаркировки(ДанныеШтрихкода));
	ПараметрыЗамены.Вставить("Причина",     ТБКПричинаЗамены(РезультатОбработкиШтрихкода));
	ДанныеШтрихкода.Вставить("ТБКЗаменаНаБК", ПараметрыЗамены);

	РезультатОбработкиШтрихкода.ОткрытьФормуВводаКодаМаркировки = Истина;

	// Гарантирует, что ЗавершитьПроверкуШтрихкодаПослеПолученияДанныхТСПИоТ уйдет в ветку
	// ЗавершитьОбработкуШтрихкода, а не выполнит обработчик оповещения как при успешной проверке.
	РезультатОбработкиШтрихкода.ТребуетсяУточнениеДанных = Истина;

КонецПроцедуры

// Проверяет, что отсканированная марка не может быть продана.
//
// Параметры:
//  РезультатОбработкиШтрихкода - См. ШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьРезультатОбработкиШтрихкода
//
// Возвращаемое значение:
//  Булево
//
Функция ТБКТребуетсяПредложитьЗаменуНаБК(РезультатОбработкиШтрихкода)

	// Процедура вызывается типовой дважды за одну обработку штрихкода - решение принимается один раз.
	Если РезультатОбработкиШтрихкода.ОткрытьФормуВводаКодаМаркировки Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;

	Если ТипЗнч(ДанныеШтрихкода) <> Тип("Структура")
		Или Не ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	СтатусКода = Неопределено;
	Если ДанныеШтрихкода.Свойство("Статус", СтатусКода)
		И (СтатусКода = ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Продан")
			Или СтатусКода = ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Списан")) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не ТБКРазрешительныйРежимОтветил(ДанныеШтрихкода) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат РезультатОбработкиШтрихкода.ЕстьОшибки
		Или РезультатОбработкиШтрихкода.ЕстьОшибкиВДеревеУпаковок
		Или РезультатОбработкиШтрихкода.ОбщаяОшибка
		Или ЗначениеЗаполнено(РезультатОбработкиШтрихкода.ТекстОшибки)
		Или ТБКМаркаОстатковСНевернойМРЦ(ДанныеШтрихкода);

КонецФункции

// ЧЗ выводил из оборота марки остатков, но часть осталась с минимальной ценой 10 000 ₽:
// продать товар по настоящей цене ЧЗ не даёт, поэтому он идёт по БК.
//
// Марку остатков узнаём по техническому GTIN (диапазон 029): emissionType в ответе ТС ПИоТ нет.
// Типовой разбор GTIN и МРЦ в данные штрихкода не кладёт - берём их из сырого ответа.
// Путь до кодов тот же, что в ИнтеграцияТСПИоТКлиентСервер.РазобратьДанныеОтветаОтТСПИоТ.
// Ответ локального модуля устроен иначе - в нём codesResponse нет.
//
Функция ТБКМаркаОстатковСНевернойМРЦ(ДанныеШтрихкода)

	ТелоОтвета = "";
	ДанныеШтрихкода.Свойство("РазрешительныйРежимТелоОтветаJSON", ТелоОтвета);
	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответ = ОбменДаннымиИСМПКлиентСервер.ТекстJSONВОбъект(ТелоОтвета, Истина);
	Если ТипЗнч(Ответ) <> Тип("Соответствие")
		Или ТипЗнч(Ответ.Получить("codesResponse")) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	ОтветыГИСМТ = Ответ.Получить("codesResponse").Получить("codesResponse");
	Если ТипЗнч(ОтветыГИСМТ) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ОтветГИСМТ Из ОтветыГИСМТ Цикл

		Коды = ОтветГИСМТ.Получить("codes");
		Если ТипЗнч(Коды) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ДанныеКода Из Коды Цикл
			// mrp - в копейках.
			Если СтрНачинаетсяС(Строка(ДанныеКода.Получить("gtin")), "029")
				И ДанныеКода.Получить("mrp") = 1000000 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Признак того, что разрешительный режим вернул ответ по существу, а не сбой инфраструктуры.
//
// Код 200 - ГИС МТ ответил. Код 203 - объявлен аварийный режим, продажа разрешена.
// Пустое значение или прочие коды - проверка не выполнялась.
//
// Параметры:
//  ДанныеШтрихкода - Структура - См. ШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьДанныеШтрихкода
//
// Возвращаемое значение:
//  Булево
//
Функция ТБКРазрешительныйРежимОтветил(ДанныеШтрихкода)

	КодОтвета = Неопределено;
	Если Не ДанныеШтрихкода.Свойство("РазрешительныйРежимКодОтвета", КодОтвета) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Тип поля нестабилен: обычно строка, в аварийном режиме туда кладут число.
	Возврат СокрЛП(Строка(КодОтвета)) = "200";

КонецФункции

// Полный код маркировки — с МРЦ и криптохвостом.
//
// В ДанныеШтрихкода.Штрихкод код обрезан (теряется криптохвост), в
// НормализованныйШтрихкод — ещё и МРЦ. Целиком он лежит в ПолныйКодМаркировки
// в формате base64.
//
// Параметры:
//  ДанныеШтрихкода - Структура - См. ШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьДанныеШтрихкода
//
// Возвращаемое значение:
//  Строка
//
Функция ТБКПолныйКодМаркировки(ДанныеШтрихкода)

	КодBase64 = "";
	ДанныеШтрихкода.Свойство("ПолныйКодМаркировки", КодBase64);

	Штрихкод = "";
	ДанныеШтрихкода.Свойство("Штрихкод", Штрихкод);

	Если Не ЗначениеЗаполнено(КодBase64) Тогда
		Возврат Строка(Штрихкод);
	КонецЕсли;

	Попытка
		Возврат ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.Base64ВШтрихкод(Строка(КодBase64));
	Исключение
		// Некорректный base64 не должен мешать продаже - отдаем то, что есть.
		Возврат Строка(Штрихкод);
	КонецПопытки;

КонецФункции

// Причина замены — записывается в регистр ТБКМаркиДляСписания.
//
// Параметры:
//  РезультатОбработкиШтрихкода - См. ШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьРезультатОбработкиШтрихкода
//
// Возвращаемое значение:
//  Строка
//
Функция ТБКПричинаЗамены(РезультатОбработкиШтрихкода)

	СтатусКода = Неопределено;
	Если РезультатОбработкиШтрихкода.ДанныеШтрихкода.Свойство("Статус", СтатусКода)
		И (СтатусКода = ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Продан")
			Или СтатусКода = ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Списан")) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Статус кода маркировки: %1'"), Строка(СтатусКода));
	КонецЕсли;

	Если ЗначениеЗаполнено(РезультатОбработкиШтрихкода.ТекстОшибки) Тогда
		Возврат Лев(СокрЛП(РезультатОбработкиШтрихкода.ТекстОшибки), 500);
	КонецЕсли;

	Если ТБКМаркаОстатковСНевернойМРЦ(РезультатОбработкиШтрихкода.ДанныеШтрихкода) Тогда
		Возврат НСтр("ru = 'Марка остатков (GTIN 029) с минимальной ценой 10 000 руб.'");
	КонецЕсли;

	Возврат НСтр("ru = 'Проверка кода маркировки не пройдена'");

КонецФункции
