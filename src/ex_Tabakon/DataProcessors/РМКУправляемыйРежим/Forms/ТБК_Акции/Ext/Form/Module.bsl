
#Область ДеревоАкций

&НаСервере
Процедура ЗаполнитьДеревоАкцийИзБазы()

	Акции.ПолучитьЭлементы().Очистить();

    // --- Шаг 1: читаем все активные акции из регистра ---
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ХС.Идентификатор КАК УИ,
	|   ХС.Наименование КАК Наименование,
    |   ХС.Сертификат  КАК ДанныеСтрокой,
	|   ХС.ДатаНачала  КАК ДатаНачала,
	|   ХС.ДатаОкончания  КАК ДатаОкончания
    |ИЗ
    |   РегистрСведений.ХранилищеСертификатов КАК ХС
    |ГДЕ
    |   ХС.ДатаНачала   <= &ТекДата
    |   И ХС.ДатаОкончания >= &ТекДата
    |   И ХС.ТипХранилища  = ЗНАЧЕНИЕ(Перечисление.ТипХранилищаСертификатов.ПерсональныеСертификаты)
    |УПОРЯДОЧИТЬ ПО
    |   ХС.Наименование";

    Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата()));
    Выборка = Запрос.Выполнить().Выгрузить();

    // --- Шаг 2: собираем все коды номенклатуры из всех акций ---
    СписокКодов = Новый СписокЗначений;

    Для Каждого Стр Из Выборка Цикл
        ДанныеАкции = Стр.ДанныеСтрокой.Получить();
		Если не ЗначениеЗаполнено(ДанныеАкции) тогда
			ДанныеАкции	=	Стр.Наименование;
		КонецЕсли;;
        // Поле 6 — коды номенклатуры (позиции 5-6)
        КодыСтрокой = ТБК_ПолучитьПолеИзСтроки(ДанныеАкции, 6);
        ТБК_КодыВСписок(КодыСтрокой, СписокКодов);
    КонецЦикла;

    // --- Шаг 3: один запрос — имена и остатки для всех товаров ---
    МапТоваров = Новый Соответствие; // Код → Структура{Наименование, Остаток}

    Если СписокКодов.Количество() > 0 Тогда
        Запрос2 = Новый Запрос;
        Запрос2.Текст =
        "ВЫБРАТЬ
        |	Ном.Код КАК Код,
        |	Ном.Наименование КАК Наименование,
        |	ЕСТЬNULL(Ост.КоличествоОстаток, 0) КАК Остаток,
        |	Ном.Ссылка КАК Ссылка,
        |	Ост.Характеристика КАК Характеристика
        |ПОМЕСТИТЬ вт_Остатки
        |ИЗ
        |	Справочник.Номенклатура КАК Ном
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК Ост
        |		ПО (Ост.Номенклатура = Ном.Ссылка)
        |ГДЕ
        |	Ном.Код В(&СписокКодов)
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	вт_Остатки.Наименование КАК Наименование,
        |	вт_Остатки.Остаток КАК Остаток,
        |	ЕСТЬNULL(ДействующиеЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
        |	вт_Остатки.Код КАК Код,
        |	вт_Остатки.Ссылка КАК Ссылка
        |ИЗ
        |	вт_Остатки КАК вт_Остатки
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеЦеныНоменклатуры.СрезПоследних(
        |				,
        |				Номенклатура В
        |					(ВЫБРАТЬ
        |						вт_Остатки.Ссылка КАК Ссылка
        |					ИЗ
        |						вт_Остатки КАК вт_Остатки)) КАК ДействующиеЦеныНоменклатурыСрезПоследних
        |		ПО вт_Остатки.Ссылка = ДействующиеЦеныНоменклатурыСрезПоследних.Номенклатура
        |			И вт_Остатки.Характеристика = ДействующиеЦеныНоменклатурыСрезПоследних.Характеристика";
				

        Запрос2.УстановитьПараметр("СписокКодов", СписокКодов);
        ТЗТоваров = Запрос2.Выполнить().Выгрузить();

        Для Каждого СтрТ Из ТЗТоваров Цикл
            МапТоваров.Вставить(СокрЛП(СтрТ.Код), Новый Структура("Наименование, Остаток, Ссылка, Цена", СтрТ.Наименование, СтрТ.Остаток, СтрТ.Ссылка, СтрТ.Цена));
		КонецЦикла;
			
    КонецЕсли;

    // --- Шаг 4: строим дерево ---
    Для Каждого Стр Из Выборка Цикл
		
        ДанныеАкции = Стр.ДанныеСтрокой.Получить();
		Если не ЗначениеЗаполнено(ДанныеАкции) тогда
			ДанныеАкции	=	Стр.Наименование;
		КонецЕсли;;
        ТипАкции       	= ТБК_ПолучитьПолеИзСтроки(ДанныеАкции, 1);
		Скидка       	= ТБК_ПолучитьПолеИзСтроки(ДанныеАкции, 2);
        КодыСтрокой    	= ТБК_ПолучитьПолеИзСтроки(ДанныеАкции, 6);
        НазваниеАкции  	= ТБК_ПолучитьПолеИзСтроки(ДанныеАкции, 10); // новое поле  	
		
		Если ЗначениеЗаполнено(НазваниеАкции) Тогда
		
			ИмяГруппы = НазваниеАкции;
		ИНаче
			ИмяГруппы = ТипАкции;
	
		
		КонецЕсли;
		//ИмяГруппы = ?(ЗначениеЗаполнено(НазваниеАкции), НазваниеАкции, ТипАкции);

        СтрГр = Акции.ПолучитьЭлементы().Добавить();
		СтрГр.ЭтоГруппа   = Истина;
        СтрГр.Наименование = ИмяГруппы;
		СтрГр.ТипАкции = ТипАкции;
		СтрГр.Скидка = Скидка + "%";
		СтрГр.ДатаНачала = Стр.ДатаНачала; 
	   	СтрГр.ДатаОкончания = Стр.ДатаОкончания;

        // товары внутри группы
        МассивКодов = СтрРазделить(КодыСтрокой, "_", Ложь);
        ОстатокГруппы = 0;

		Для Каждого Код Из МассивКодов Цикл
			Код = СокрЛП(Код);
			Если Не ЗначениеЗаполнено(Код) Тогда Продолжить КонецЕсли;
			
			ДанныеТовара = МапТоваров[Код];
			Если ДанныеТовара = Неопределено Тогда Продолжить КонецЕсли;
			
			Если ДанныеТовара.Остаток = 0 И ДанныеТовара.Ссылка.ЭтоГруппа Тогда
				
				Массив = Новый Массив;
				Массив.Добавить(ДанныеТовара.Ссылка);
				
				МассивНоменклатуры = Обработки.РМКУправляемыйРежим.ПолучитьСписокНоменклатуры(Массив);
				
				Запрос3 = Новый Запрос;
				Запрос3.Текст =
				"ВЫБРАТЬ
				|	ЕСТЬNULL(Ост.КоличествоОстаток, 0) КАК Остаток,
				|	Ост.Номенклатура.Наименование КАК Наименование,
				|	Ост.Номенклатура.Ссылка КАК Ссылка,
				|	Ост.Характеристика КАК Характеристика
				|ПОМЕСТИТЬ вт_Остатки
				|ИЗ
				|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура В (&Группа)) КАК Ост
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	вт_Остатки.Наименование КАК Наименование,
				|	вт_Остатки.Остаток КАК Остаток,
				|	ЕСТЬNULL(ДействующиеЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
				|ИЗ
				|	вт_Остатки КАК вт_Остатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеЦеныНоменклатуры.СрезПоследних(
				|				,
				|				Номенклатура В
				|					(ВЫБРАТЬ
				|						вт_Остатки.Ссылка КАК Ссылка
				|					ИЗ
				|						вт_Остатки КАК вт_Остатки)) КАК ДействующиеЦеныНоменклатурыСрезПоследних
				|		ПО вт_Остатки.Ссылка = ДействующиеЦеныНоменклатурыСрезПоследних.Номенклатура
				|			И вт_Остатки.Характеристика = ДействующиеЦеныНоменклатурыСрезПоследних.Характеристика";
				
				Запрос3.УстановитьПараметр("Группа", МассивНоменклатуры); 
				
				РезультатЗапроса = Запрос3.Выполнить();
				ВыборкаОстаток = РезультатЗапроса.Выбрать();
				
				ФлГруппаДобавлена = ложь;	
				Пока ВыборкаОстаток.Следующий() Цикл
					
					Если не ФлГруппаДобавлена Тогда
						
						СтрТов = СтрГр.ПолучитьЭлементы().Добавить();
						СтрТов.Наименование = ДанныеТовара.Наименование;
						СтрТов.ЭтоГруппа   = Ложь;
						
					   	ФлГруппаДобавлена = Истина;
						
					КонецЕсли;
					
					СтрТов.Остаток = СтрТов.Остаток + ВыборкаОстаток.Остаток;
					
					НовСтрокаЭлемента = СтрТов.ПолучитьЭлементы().Добавить();
					НовСтрокаЭлемента.Наименование = ВыборкаОстаток.Наименование;
					НовСтрокаЭлемента.Остаток      = ВыборкаОстаток.Остаток;
					НовСтрокаЭлемента.Цена         = ВыборкаОстаток.Цена;					
				
				КонецЦикла;					                                    
				
			КонецЕсли;
			
			ОстатокГруппы = ОстатокГруппы + СтрТов.Остаток;
			
		КонецЦикла;

        СтрГр.Остаток = ОстатокГруппы; 
		
		Если СтрГр.Остаток = 0 Тогда
			Акции.ПолучитьЭлементы().Удалить(СтрГр);
		КонецЕсли;

	КонецЦикла;
	
	Прокси = ОбщегоНазначенияВызовСервера.ПолучитьПроктиWStbk();
	Если Прокси = Неопределено Тогда
	
		СтрГр = Акции.ПолучитьЭлементы().Добавить();
		СтрГр.ЭтоГруппа   = Истина;
        СтрГр.Наименование = "Не удалось получить акции по желтым ценникам. Проверьте интернет";
	    Возврат;
		
	КонецЕсли;
	
	Попытка
		Ответ = Прокси.GetSale();	
	Исключение
		СтрГр = Акции.ПолучитьЭлементы().Добавить();
		СтрГр.ЭтоГруппа   = Истина;
        СтрГр.Наименование = "Не удалось получить акции по желтым ценникам. Проверьте интернет";
		Прокси = Неопределено;
	    Возврат;
	КонецПопытки;
	
	Прокси = Неопределено;
	
	МассивОтвет = ОбщегоНазначения.jsonВСтруктура_Общая(Ответ);
	
	СписокКодов = Новый Массив;
	
	Для каждого НоменклатурнаяГруппа Из МассивОтвет Цикл
		
		Для каждого ЭлементНоменклатура Из НоменклатурнаяГруппа.МассивНоменклатура Цикл	
		    СписокКодов.Добавить(ЭлементНоменклатура.Код);
		КонецЦикла;
	
	КонецЦикла; 
	
	МапТоваров = Новый Соответствие;
	
	Если СписокКодов.Количество() > 0 Тогда
		Запрос2 = Новый Запрос;
		Запрос2.Текст =
		"ВЫБРАТЬ
		|	Ном.Код КАК Код,
		|	Ном.Наименование КАК Наименование,
		|	ЕСТЬNULL(Ост.КоличествоОстаток, 0) КАК Остаток,
		|	Ном.Ссылка КАК Ссылка,
		|	Ост.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ вт_Остаток
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК Ост
		|		ПО (Ост.Номенклатура = Ном.Ссылка)
		|ГДЕ
		|	Ном.Код В(&СписокКодов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДействующиеЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
		|	вт_Остаток.Остаток КАК Остаток,
		|	вт_Остаток.Наименование КАК Наименование,
		|	вт_Остаток.Код КАК Код,
		|	вт_Остаток.Ссылка КАК Ссылка
		|ИЗ
		|	вт_Остаток КАК вт_Остаток
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеЦеныНоменклатуры.СрезПоследних КАК ДействующиеЦеныНоменклатурыСрезПоследних
		|		ПО вт_Остаток.Ссылка = ДействующиеЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И вт_Остаток.Характеристика = ДействующиеЦеныНоменклатурыСрезПоследних.Характеристика";
		
		
		Запрос2.УстановитьПараметр("СписокКодов", СписокКодов);
		ТЗТоваров = Запрос2.Выполнить().Выгрузить();
		
		Для Каждого СтрТ Из ТЗТоваров Цикл
			МапТоваров.Вставить(СокрЛП(СтрТ.Код), Новый Структура("Наименование, Остаток, Ссылка, Цена", СтрТ.Наименование, СтрТ.Остаток, СтрТ.Ссылка, СтрТ.Цена));
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого Элемент Из МассивОтвет Цикл
				
		СтрГр = Акции.ПолучитьЭлементы().Добавить();
		СтрГр.ЭтоГруппа   = Истина;
        СтрГр.Наименование = Элемент.НоменклатурнаяГруппа;
		
		ОстатокГруппы = 0;
		
		Для каждого ЭлементНоменклатура Из Элемент.МассивНоменклатура Цикл	
			ДанныеТовара = МапТоваров[ЭлементНоменклатура.Код];
			
			Если ДанныеТовара <> Неопределено Тогда
				
				Если ДанныеТовара.Остаток <> 0 Тогда
					
					СтрТов = СтрГр.ПолучитьЭлементы().Добавить();
					СтрТов.Наименование = ДанныеТовара.Наименование;
					СтрТов.Остаток      = ДанныеТовара.Остаток;
					СтрТов.Цена         = ДанныеТовара.Цена;
					СтрТов.ЭтоГруппа    = Ложь;
					
					//Марк 2026-05-18 https://jira.tabkn.ru/browse/PRIC-130-----------
					Если ДанныеТовара.Ссылка.ЭтоГруппа Тогда
						
						Массив = Новый Массив;
						Массив.Добавить(ДанныеТовара.Ссылка);
						
						МассивНоменклатуры = Обработки.РМКУправляемыйРежим.ПолучитьСписокНоменклатуры(Массив);
						
						Запрос4 = Новый Запрос;
						Запрос4.Текст =
						"ВЫБРАТЬ
						|	СУММА(ЕСТЬNULL(Ост.КоличествоОстаток, 0)) КАК Остаток,
						|	Ост.Номенклатура.Представление КАК Номенклатура,
						|	Ост.Номенклатура КАК НоменклатураСсылка,
						|	Ост.Характеристика КАК Характеристика
						|ПОМЕСТИТЬ вт_Остаток
						|ИЗ
						|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура В (&Группа)) КАК Ост
						|ГДЕ
						|	Ост.КоличествоОстаток > 0
						|
						|СГРУППИРОВАТЬ ПО
						|	Ост.Номенклатура.Представление,
						|	Ост.Номенклатура,
						|	Ост.Характеристика
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ДействующиеЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
						|	вт_Остаток.Остаток КАК Остаток,
						|	вт_Остаток.Номенклатура КАК Номенклатура
						|ИЗ
						|	вт_Остаток КАК вт_Остаток
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеЦеныНоменклатуры.СрезПоследних КАК ДействующиеЦеныНоменклатурыСрезПоследних
						|		ПО вт_Остаток.НоменклатураСсылка = ДействующиеЦеныНоменклатурыСрезПоследних.Номенклатура
						|			И вт_Остаток.Характеристика = ДействующиеЦеныНоменклатурыСрезПоследних.Характеристика";
						
						Запрос4.УстановитьПараметр("Группа", МассивНоменклатуры); 
						
						ВыборкаНоменклатура = Запрос4.Выполнить().Выбрать();
						
						Пока ВыборкаНоменклатура.Следующий() Цикл
							
							СтрТов2 = СтрТов.ПолучитьЭлементы().Добавить();
							СтрТов2.Наименование = ВыборкаНоменклатура.Номенклатура;
							СтрТов2.Остаток      = ВыборкаНоменклатура.Остаток;
							СтрТов2.Цена         = ВыборкаНоменклатура.Цена;
							СтрТов2.ЭтоГруппа    = Ложь;	
							
						КонецЦикла;
						
					КонецЕсли;
					//-----------------------------------------------------------------
					
					
				    ОстатокГруппы = ОстатокГруппы + ДанныеТовара.Остаток;
				КонецЕсли;
								
			КонецЕсли;
			
		КонецЦикла;
		
		СтрГр.Остаток = ОстатокГруппы;
		
		Если СтрГр.Остаток = 0 Тогда
			Акции.ПолучитьЭлементы().Удалить(СтрГр);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Возвращает N-е поле из строки разделённой "/"
&НаСервере
Функция ТБК_ПолучитьПолеИзСтроки(Строка, НомерПоля)
    Части = СтрРазделить(Строка, "/", Истина);
    Если НомерПоля > Части.Количество() Тогда
        Возврат "";
    КонецЕсли;
    Возврат СокрЛП(Части[НомерПоля - 1]);
КонецФункции

// Добавляет коды из строки "00000001_00000002_" в список значений (без дублей)
&НаСервере
Процедура ТБК_КодыВСписок(КодыСтрокой, СписокКодов)
    МассивКодов = СтрРазделить(КодыСтрокой, "_", Ложь);
    Для Каждого Код Из МассивКодов Цикл
        Код = СокрЛП(Код);
        Если ЗначениеЗаполнено(Код) И СписокКодов.НайтиПоЗначению(Код) = Неопределено Тогда
            СписокКодов.Добавить(Код);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// — тестовые данные оставлены как резерв —
&НаСервере
Процедура ЗаполнитьДеревоАкцийТестовымиДанными()

	Акции.ПолучитьЭлементы().Очистить();

	// Группа 1
	Гр1 = Акции.ПолучитьЭлементы().Добавить();
	Гр1.Наименование = "Фиксированная РАСПРОДАЖА напитки";
	Гр1.ЭтоГруппа   = Истина;

	ТБК_ДобавитьТоварВДерево(Гр1, "Сок апельсиновый 1л",        5);
	ТБК_ДобавитьТоварВДерево(Гр1, "Вода минеральная Bon Aqua",  0);
	ТБК_ДобавитьТоварВДерево(Гр1, "Квас Никола 2л",             4);
	ТБК_ДобавитьТоварВДерево(Гр1, "Пиво Балтика №3 0,5л",      12);
	ТБК_ДобавитьТоварВДерево(Гр1, "Лимонад Буратино 1л",        3);
	ТБК_ПосчитатьОстатокГруппы(Гр1);

	// Группа 2
	Гр2 = Акции.ПолучитьЭлементы().Добавить();
	Гр2.Наименование = "Молочная продукция — акция недели";
	Гр2.ЭтоГруппа   = Истина;

	ТБК_ДобавитьТоварВДерево(Гр2, "Молоко Простоквашино 1л",    2);
	ТБК_ДобавитьТоварВДерево(Гр2, "Кефир 1% 0,9л",              0);
	ТБК_ДобавитьТоварВДерево(Гр2, "Сметана 20% 400г",           7);
	ТБК_ДобавитьТоварВДерево(Гр2, "Творог 9% 180г",             1);
	ТБК_ПосчитатьОстатокГруппы(Гр2);

	// Группа 3
	Гр3 = Акции.ПолучитьЭлементы().Добавить();
	Гр3.Наименование = "Кондитерские изделия — спеццена";
	Гр3.ЭтоГруппа   = Истина;

	ТБК_ДобавитьТоварВДерево(Гр3, "Шоколад Алёнка 100г",       15);
	ТБК_ДобавитьТоварВДерево(Гр3, "Печенье Юбилейное 500г",     3);
	ТБК_ДобавитьТоварВДерево(Гр3, "Вафли Артек 250г",           0);
	ТБК_ДобавитьТоварВДерево(Гр3, "Зефир в шоколаде 250г",      8);
	ТБК_ПосчитатьОстатокГруппы(Гр3);

КонецПроцедуры

&НаСервере
Процедура ТБК_ДобавитьТоварВДерево(СтрокаГруппы, Наименование, Остаток)
	Стр = СтрокаГруппы.ПолучитьЭлементы().Добавить();
	Стр.Наименование = Наименование;
	Стр.Остаток      = Остаток;
	Стр.ЭтоГруппа   = Ложь;
КонецПроцедуры

&НаСервере
Процедура ТБК_ПосчитатьОстатокГруппы(СтрокаГруппы)
	Итого = 0;
	Для Каждого Стр Из СтрокаГруппы.ПолучитьЭлементы() Цикл
		Итого = Итого + Стр.Остаток;
	КонецЦикла;
	СтрокаГруппы.Остаток = Итого;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьДеревоАкцийИзБазы()
КонецПроцедуры

#КонецОбласти

