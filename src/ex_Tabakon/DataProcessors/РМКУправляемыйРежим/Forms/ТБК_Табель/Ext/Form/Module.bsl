&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	СоответствиеОписаниеВидовВремени = Новый Соответствие;
	// Для получения значения по буквенному обозначению.
	СоответствиеОписаниеВидовВремени.Вставить(НСтр("ru = 'Я'"),
	ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Явка"));
	СоответствиеОписаниеВидовВремени.Вставить(НСтр("ru = 'Б'"),
	ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Больничный"));
	СоответствиеОписаниеВидовВремени.Вставить(НСтр("ru = 'Н'"),
	ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.НочныеЧасы"));
	СоответствиеОписаниеВидовВремени.Вставить(НСтр("ru = 'О'"),
	ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Отпуск"));
	
	// Для получения буквенного обозначения по значению.
	СоответствиеОписаниеВидовВремени.Вставить(ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Явка"),
	НСтр("ru = 'Я'"));
	СоответствиеОписаниеВидовВремени.Вставить(ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Больничный"),
	НСтр("ru = 'Б'"));
	СоответствиеОписаниеВидовВремени.Вставить(ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.НочныеЧасы"),
	НСтр("ru = 'Н'"));
	СоответствиеОписаниеВидовВремени.Вставить(ПредопределенноеЗначение("Перечисление.ВидыИспользованияРабочегоВремени.Отпуск"),
	НСтр("ru = 'О'"));
	
	ОписаниеВидовВремени = Новый ФиксированноеСоответствие(СоответствиеОписаниеВидовВремени);
	
	//МесяцРегистрацииСтрокой = ПолучитьПредставлениеМесяца(ПериодРегистрации);
	
	//ТабельУстановитьВидимостьКолонокДнейПериода();
	
	ОформитьПоляТаблицыДнейМесяца(Элементы, НачалоМесяца(Дата), "ДанныеОВремениВремя%1");
	
КонецПроцедуры

// а
Процедура ОформитьПоляТаблицыДнейМесяца(ЭлементыФормы, Месяц, ШаблонИмениПоля) Экспорт
	
	ЦветРабочегоДня = ЦветаСтиля.ЦветТекстаФормы;
	ЦветВыходногоДня = ЦветаСтиля.ЦветОсобогоТекста;
	
	ПоследнийДеньМесяца = День(КонецМесяца(Месяц));
	
	Для НомерДня = 1 По ПоследнийДеньМесяца Цикл
		
		ТекущийДень = Дата(Год(Месяц), Месяц(Месяц), НомерДня);
		
		ДеньНедели = ДеньНедели(ТекущийДень);
		
		Элемент = ЭлементыФормы[СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмениПоля, НомерДня)];
		Элемент.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1%2%3", НомерДня, Символы.ПС, Формат(ТекущийДень, "ДФ=ддд"));
		Элемент.ЦветТекстаЗаголовка = ?(ДеньНедели = 6 Или ДеньНедели = 7, ЦветВыходногоДня, ЦветРабочегоДня);
		
	КонецЦикла;		
КонецПроцедуры	

