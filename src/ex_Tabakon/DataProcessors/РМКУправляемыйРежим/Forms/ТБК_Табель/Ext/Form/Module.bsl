КонецФункции

&НаСервере
Процедура ТабельЗаполнитьДанныеПоСотрудникам()
	ВыборкаДанныхОВремени = ДанныеСотрудников();
	ТабельЗаполнитьДанные(ВыборкаДанныхОВремени);
	ДанныеУТ = ЗапросКУТ();
	Если ДанныеУТ <> Неопределено Тогда
		ТабельЗаполнитьДанные(ДанныеУТ);
	КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура ТабельЗаполнитьДанные(ВыборкаДанныхОВремени)
	
	//ВыборкаДанныхОВремени = Документы.ТабельУчетаРабочегоВремени.ДанныеОВремениСотрудников(Объект, СписокСотрудников); ДанныеСотрудников()
	//ВыборкаДанныхОВремени = ДанныеСотрудников();
	
	СтрокиПоСотрудникам = Неопределено;
	
	ТекущийСотрудник = Неопределено;
	ДанныеОВремениПоСотруднику = Новый Массив;
	НомерСтрокиСотрудник = 1;
	
	ДанныеОВремениПоСотруднику = Новый ТаблицаЗначений;
	ДанныеОВремениПоСотруднику.Колонки.Добавить("Сотрудник");
	ДанныеОВремениПоСотруднику.Колонки.Добавить("ДанныеИсточник");
	ДанныеОВремениПоСотруднику.Колонки.Добавить("ВидВремени");
	ДанныеОВремениПоСотруднику.Колонки.Добавить("Дата");
	ДанныеОВремениПоСотруднику.Колонки.Добавить("Дни");
	ДанныеОВремениПоСотруднику.Колонки.Добавить("Часы");
	
	Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
		ДанныеОВремениПоСотруднику.Очистить();
		
		Пока ВыборкаДанныхОВремени.Следующий() Цикл
			СтрокаТаблицыДанныхОВремени = ДанныеОВремениПоСотруднику.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДанныхОВремени, ВыборкаДанныхОВремени);
		КонецЦикла;	
		
		Если СтрокиПоСотрудникам = Неопределено Тогда
			МассивСтрокПоСотруднику = ТабельНоваяСтрокаДанныхОВремени(ДанныеОВремени, ВыборкаДанныхОВремени.Сотрудник, НомерСтрокиСотрудник, ВыборкаДанныхОВремени.ДанныеИсточник);
		Иначе					
			МассивСтрокПоСотруднику = СтрокиПоСотрудникам[ВыборкаДанныхОВремени.Сотрудник];
		КонецЕсли;	
		
		ТабельЗаполнитьСтрокиПоСотруднику(
		ДанныеОВремениПоСотруднику, 
		МассивСтрокПоСотруднику);
		
		НомерСтрокиСотрудник = НомерСтрокиСотрудник + 1;	
		
	КонецЦикла;	
	
	//ТабельЗаполнитьИтогиПоСотрудникамДокумента();
	//УстановитьУсловноеОформление();
	
КонецПроцедуры

Функция ДанныеСотрудников()
	
	
	Запрос = Новый Запрос;
	
	//Установка значений параметров
	Запрос.УстановитьПараметр("Продавец", Продавец);
	Запрос.УстановитьПараметр("ДатаНач", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(Дата));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.Продавец КАК Сотрудник,
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.ВремяСмены КАК Часы,
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Магазин КАК Магазин,
	|	Значение(Перечисление.ВидыИспользованияРабочегоВремени.Явка) КАК ВидВремени,
	|    ""Офис"" КАК ДанныеИсточник
	|ИЗ
	|	Документ.ТБК_ВедомостьОПродажахЗаДень.Продавцы КАК ТБК_ВедомостьОПродажахЗаДеньПродавцы
	|ГДЕ
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Проведен
	|	И ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ ТБК_ВедомостьОПродажахЗаДеньПродавцы.ПродавецНаЗамену
	|	И ТБК_ВедомостьОПродажахЗаДеньПродавцы.Продавец = &Продавец
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Дата, ДЕНЬ),
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.Продавец,
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.ВремяСмены,
	|	ТБК_ВедомостьОПродажахЗаДеньПродавцы.Ссылка.Магазин
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	Дата,
	|	ВидВремени";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции // ДанныеСотрудников()


&НаСервере
Процедура УстановитьУсловноеОформление()
	// Очищаем существующее условное оформление
	УсловноеОформление.Элементы.Очистить();
	
	// Получаем таблицу значений с формы
	//ТаблицаЗначений = ДанныеОВремени;
	
	ТаблицаЗначений = РеквизитФормыВЗначение("ДанныеОВремени");
	
	// Проверяем, что в таблице есть минимум 2 строки для сравнения
	Если ТаблицаЗначений.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	// Берем первую и вторую строку для сравнения
	Строка1 = ТаблицаЗначений[0];
	Строка2 = ТаблицаЗначений[1];
	
	// Перебираем все колонки от время1 до время30
	Для НомерКолонки = 3 По ТаблицаЗначений.Колонки.Количество() - 5 Цикл
		ИмяКолонки = "время" + Формат(НомерКолонки, "ЧГ=");
		
		// Получаем значения из обеих строк для текущей колонки
		Значение1 = Строка1[ИмяКолонки];
		Значение2 = Строка2[ИмяКолонки];
		
		// Если значения различаются — создаем правило оформления
		Если Значение1 <> Значение2 Тогда
			
			// Создаем новый элемент условного оформления
			ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
			
			// Указываем, какую колонку оформлять
			ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			Поле = Элементы.Найти("ДанныеОВремени" + ИмяКолонки);
			
			ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
			ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт("Arial", 10, Истина));
			ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",  WebЦвета.Лосось);
			
			// отбор для оформления по условию
			ЭлементУсловия                = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Истина");
			ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
			ЭлементУсловия.ПравоеЗначение = 500;
			ЭлементУсловия.Использование  = Истина;
			// что оформляем
			ОформляемоеПоле      = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Поле.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТабельПредставлениеВремениПоВиду( КоличествоЧасов) Экспорт 
	
	Если КоличествоЧасов <> 0 Тогда
		Возврат Формат(КоличествоЧасов, "ЧГ=");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ТабельЗаполнитьСтрокиПоСотруднику(ДанныеОВремениПоСотруднику, МассивСтрокПоСотруднику)
	
	ОбрабатываемаяДата = '00010101';	
	
	Для Каждого СтрокаДанныхОВремени Из ДанныеОВремениПоСотруднику Цикл
		
		Если СтрокаДанныхОВремени.Дата <> ОбрабатываемаяДата Тогда 
			НомерДня = День(СтрокаДанныхОВремени.Дата);	
			НомерВидаВремениНаДату = 1;
		Иначе
			НомерВидаВремениНаДату = НомерВидаВремениНаДату + 1;
		КонецЕсли;
		
		Если НомерВидаВремениНаДату > МассивСтрокПоСотруднику.Количество() Тогда
			СтрокаТабеля = ТабельНоваяСтрокаПоСотруднику(ДанныеОВремени, МассивСтрокПоСотруднику[0]);	
			МассивСтрокПоСотруднику.Добавить(СтрокаТабеля);
		Иначе
			СтрокаТабеля = МассивСтрокПоСотруднику[НомерВидаВремениНаДату - 1];		
		КонецЕсли;	
		
		//СтрокаТабеля["ВидВремени" + НомерДня] = СтрокаДанныхОВремени.ВидВремени;
		//СтрокаТабеля["Часов" + НомерДня] = СтрокаДанныхОВремени.Часы;
		//БуквенноеОбозначение = Лев(Строка(СтрокаДанныхОВремени.ВидВремени),1);
		
		СтрокаТабеля["Время" + НомерДня] = ТабельПредставлениеВремениПоВиду(СтрокаДанныхОВремени.Часы);  
		
		ОбрабатываемаяДата = СтрокаДанныхОВремени.Дата;
		
	КонецЦикла;	
	
	КоличествоСтрокПоСотруднику = МассивСтрокПоСотруднику.Количество();
	
	Сотрудник = МассивСтрокПоСотруднику[0].Сотрудник;
	
	Для Каждого СтрокаПоСотруднику Из МассивСтрокПоСотруднику Цикл
		СтрокаПоСотруднику.Сотрудник = Сотрудник;		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ТабельНоваяСтрокаДанныхОВремени(ДанныеОВремени, Сотрудник, НомерСтрокиСотрудник, Источник)
	СтрокиПоСотруднику = Новый Массив;
	
	НоваяСтрока = ДанныеОВремени.Добавить();
	НоваяСтрока.Сотрудник = Сотрудник;
	НоваяСтрока.НомерСтрокиСотрудник = НомерСтрокиСотрудник;
	НоваяСтрока.ДанныеИсточник = Источник;
	
	СтрокиПоСотруднику.Добавить(НоваяСтрока);
	
	//ВтораяНоваяСтрока = ДанныеОВремени.Добавить();
	//ВтораяНоваяСтрока.Сотрудник = Сотрудник;
	//ВтораяНоваяСтрока.НомерСтрокиСотрудник = НомерСтрокиСотрудник;
	//
	//СтрокиПоСотруднику.Добавить(ВтораяНоваяСтрока);
	
	Возврат СтрокиПоСотруднику;
КонецФункции

&НаСервере
Функция ТабельНоваяСтрокаПоСотруднику(ДанныеОВремени, ГоловнаяСтрокаПоСотруднику) Экспорт 
	
	ИндексГоловнойСтроки = ДанныеОВремени.Индекс(ГоловнаяСтрокаПоСотруднику);
	
	ОбщееКоличествоСтрок = ДанныеОВремени.Количество();
	
	СтруктураПоиска = Новый Структура("НомерСтрокиСотрудник", ГоловнаяСтрокаПоСотруднику.НомерСтрокиСотрудник + 1);
	
	СтрокиСледующегоСотрудника = ДанныеОВремени.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиСледующегоСотрудника.Количество() > 0 Тогда
		ИндексДобавляемойСтроки = ДанныеОВремени.Индекс(СтрокиСледующегоСотрудника[0]); 
		НоваяСтрока = ДанныеОВремени.Вставить(ИндексДобавляемойСтроки);
	Иначе
		НоваяСтрока = ДанныеОВремени.Добавить();
	КонецЕсли;
	
	НоваяСтрока.НомерСтрокиСотрудник = ГоловнаяСтрокаПоСотруднику.НомерСтрокиСотрудник;
	НоваяСтрока.Сотрудник = ГоловнаяСтрокаПоСотруднику.Сотрудник;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
