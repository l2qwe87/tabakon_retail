#КонецОбласти


&НаСервере
Функция ЗапросКУТ()
	
	ДанныеУТ	=	Новый ТаблицаЗначений;
	ДанныеУТ.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ДанныеУТ.Колонки.Добавить("Часы", Новый ОписаниеТипов("Число"));
	
	Если Адрес_ВебСоединение  = "" тогда
		Прокси = ОбщегоНазначенияВызовСервера.ПолучитьПрокси("123456", "WS_User_tbk", "http://mx.tbkon.ru:1777/ut/ws/tbk?wsdl");
		
		Массив	=	новый Массив;
		Массив.Добавить(Прокси);
		
		Адрес_ВебСоединение	=	ПоместитьВоВременноеХранилище(Массив,ЭтаФорма.УникальныйИдентификатор); 
	иначе
		
		Попытка
			Массив = ПолучитьИзВременногоХранилища(Адрес_ВебСоединение);
			Прокси	=	Массив[0]; 
			
			Если Прокси = Неопределено тогда//повторное подключение
				Прокси = ОбщегоНазначенияВызовСервера.ПолучитьПрокси("123456", "WS_User_tbk", "http://mx.tbkon.ru:1777/ut/ws/tbk?wsdl");
				
				Массив	=	новый Массив;    					
				Массив.Добавить(Прокси);
				
				Адрес_ВебСоединение	=	ПоместитьВоВременноеХранилище(Массив,ЭтаФорма.УникальныйИдентификатор); 
				
			КонецЕсли;
		Исключение
			Сообщить("Не удалось подключиться к УТ. Попробуйте выполнить действие позже.");
			Возврат Неопределено; 
		КонецПопытки;
		
	КонецЕсли;
	
	
	Если Прокси <> Неопределено тогда
		
		НужСклад	= СокрЛП(Строка(ОбщегоНазначения.ПолучитьСкладИзООРП()));
		
		Структура = Новый Структура;
		
		Структура.Вставить("ДатаНач",Строка(НачалоМесяца(Дата)));
		Структура.Вставить("ДатаКон",Строка(КонецМесяца(Дата)));
		
		Структура.Вставить("Продавец", 	            Строка(Продавец));
		Структура.Вставить("Магазин", 	            Строка(НужСклад)); 
		
		JS = ОбщегоНазначения.СтруктураВjson_Общая(Структура);
		
		//1. Проставляем замены
		Ответ	=	Прокси.get_sverkatabel(JS);
		Если ЗначениеЗаполнено(Ответ) тогда
			Если не Найти(Ответ,"Внимание!") тогда 
				
				ОтветМассив	=	ОбщегоНазначения.jsonВСтруктура_Общая(Ответ);//В массив
				ТаблицаЗначений = ИнтеграцияИС.МассивВТаблицуЗначений(ОтветМассив);
				НомСч	=	0;
				
				Для каждого СтрокаМассива из ОтветМассив цикл //добавляем
					
					СтрокаДанныеУТ = ДанныеУТ.Добавить();
					СтрокаДанныеУТ.Дата = Дата(СтрокаМассива.День);
					СтрокаДанныеУТ.Часы = Число(СтрокаМассива.Часы);
				КонецЦикла; 
			иначе
				Сообщить(Ответ); 				
			КонецЕсли;
		КонецЕсли;
	иначе
		Сообщить("Не удалось получить данные. Попоробуйте позже");
		
	КонецЕсли;
	
	Если ДанныеУТ.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеУТ.Дата КАК Дата,
		|	ДанныеУТ.Часы КАК Часы,
		|	&Магазин КАК Магазин,
		|	&Сотрудник КАК Сотрудник,
		|	&ВидВремени КАК ВидВремени,
		|	""Магазин"" КАК ДанныеИсточник
		|ПОМЕСТИТЬ вт_
		|ИЗ
		|	&ДанныеУТ КАК ДанныеУТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_.Дата КАК Дата,
		|	вт_.Часы КАК Часы,
		|	вт_.Магазин КАК Магазин,
		|	вт_.Сотрудник КАК Сотрудник,
		|	вт_.ВидВремени КАК ВидВремени,
		|	вт_.ДанныеИсточник КАК ДанныеИсточник
		|ИЗ
		|	вт_ КАК вт_
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник,
		|	Дата,
		|	ВидВремени";
		
		Запрос.УстановитьПараметр("ВидВремени", Перечисления.ВидыИспользованияРабочегоВремени.Явка);
		Запрос.УстановитьПараметр("Магазин", Магазин);
		Запрос.УстановитьПараметр("Сотрудник", Продавец);
		Запрос.УстановитьПараметр("ДанныеУТ", ДанныеУТ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Возврат Выборка; 
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Процедура ПериодРегистрацииПриИзменении(Элемент)
	
	Дата = ПолучитьЗначениеИзСоответствия(МесяцРегистрацииСтрокой);
	
	ДатаПриИзменении(Неопределено);
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеИзСоответствия(Ключ)
	
	СоответствияМесяц = Новый Соответствие;
	
	ТекДата = ТекущаяДата();
	
	Для НомерМесяца = 0 По 3 Цикл
		ДатаМесяца = ДобавитьМесяц(ТекДата, -НомерМесяца);
		// Получаем первый день месяца
		ПервыйДень = НачалоМесяца(ДатаМесяца);
		
		ИмяМесяца = Формат(ПервыйДень, "ДФ=MMMM");
		Год = Формат(ПервыйДень, "ДФ=yyyy");
		
		Месяц = ИмяМесяца + " " + Год;
		
		СоответствияМесяц.Вставить(Месяц, ПервыйДень);
	КонецЦикла;
	
	Возврат СоответствияМесяц[Ключ];
КонецФункции

