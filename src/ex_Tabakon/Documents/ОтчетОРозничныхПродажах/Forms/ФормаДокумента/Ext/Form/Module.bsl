
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ТБКПриОткрытииПосле(Отказ)

	ЕстьПравоРедактирования = ОбщегоНазначенияВызовСервера.ПроверитьВозможностьРедактирования_Общая();

	ТолькоПросмотр = Не ЕстьПравоРедактирования;
	Элементы.ФормаВыгрузитьДокументВФайл.Видимость = ЕстьПравоРедактирования;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Файл собирается на сервере и отдается через ФайловаяСистемаКлиент: запись файла прямо с клиента
// в веб-клиенте недоступна.
//
&НаКлиенте
Процедура ТБКВыгрузитьДокументВФайлПосле(Команда)

	АдресФайла = ТБКПоместитьФайлВыгрузкиВоВременноеХранилище(Объект.Ссылка, УникальныйИдентификатор);

	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл, куда записать документы'");
	ПараметрыСохранения.Диалог.Расширение = "json";
	ПараметрыСохранения.Диалог.Фильтр = НСтр("ru = 'JSON (*.json)|*.json'");

	ИмяФайла = СтрШаблон("ОРП %1.json", СокрЛП(Объект.Номер));

	Оповещение = Новый ОписаниеОповещения("ТБКВыгрузитьДокументВФайлЗавершение", ЭтотОбъект);
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, ИмяФайла, ПараметрыСохранения);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик оповещения после сохранения файла в ТБКВыгрузитьДокументВФайлПосле.
//
// Параметры:
//  ПолученныеФайлы - Массив из ОписаниеПереданногоФайла, Неопределено - сохраненный файл; Неопределено, если
//                    сохранение отменено.
//  ДополнительныеПараметры - Неопределено - не используются.
//
&НаКлиенте
Процедура ТБКВыгрузитьДокументВФайлЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ПолученныеФайлы) <> Тип("Массив") Или ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначенияКлиент.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'Файл сформирован: %1'"), ПолученныеФайлы[0].Имя));

КонецПроцедуры

// Записывает данные отчета в JSON (UTF-8 без BOM) и помещает файл во временное хранилище формы.
//
// Параметры:
//  Ссылка - ДокументСсылка.ОтчетОРозничныхПродажах - выгружаемый отчет.
//  ИдентификаторФормы - УникальныйИдентификатор - форма, при закрытии которой файл удаляется из хранилища.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла во временном хранилище.
//
&НаСервереБезКонтекста
Функция ТБКПоместитьФайлВыгрузкиВоВременноеХранилище(Ссылка, ИдентификаторФормы)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТБКДанныеОтчетаДляВыгрузки(Ссылка));
	ТекстJSON = ЗаписьJSON.Закрыть();

	Возврат ПоместитьВоВременноеХранилище(
		ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь), ИдентификаторФормы);

КонецФункции

// Собирает данные записанного отчета для выгрузки в JSON: шапку и строки товаров.
// Без контекста формы: нужна только ссылка, а данные формы ОРП тяжелые (товары, марки).
//
// Параметры:
//  Ссылка - ДокументСсылка.ОтчетОРозничныхПродажах - выгружаемый отчет.
//
// Возвращаемое значение:
//  Массив из Структура - одна структура на отчет; пустой массив, если в отчете нет строк товаров:
//   * Склад - Строка - склад продажи магазина.
//   * СуммаДокумента - Число
//   * Номер - Строка
//   * Дата - Строка
//   * Товары - Массив из Структура - НоменклатураУИ, Номенклатура, ХарактеристикаУИ, Характеристика,
//                                     Количество, Цена.
//
&НаСервереБезКонтекста
Функция ТБКДанныеОтчетаДляВыгрузки(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отчет.Магазин.СкладПродажи КАК СкладПродажи,
	|	Отчет.СуммаДокумента КАК СуммаДокумента,
	|	Отчет.Номер КАК Номер,
	|	Отчет.Дата КАК Дата
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК Отчет
	|ГДЕ
	|	Отчет.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОтчета.Номенклатура КАК Номенклатура,
	|	ТоварыОтчета.Характеристика КАК Характеристика,
	|	ТоварыОтчета.Количество КАК Количество,
	|	ТоварыОтчета.Цена КАК Цена
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Товары КАК ТоварыОтчета
	|ГДЕ
	|	ТоварыОтчета.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыОтчета.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Результаты = Запрос.ВыполнитьПакет();

	ДанныеОтчета = Новый Массив;

	ВыборкаТовары = Результаты[1].Выбрать();
	Если ВыборкаТовары.Количество() = 0 Тогда
		Возврат ДанныеОтчета;
	КонецЕсли;

	СтрокиТоваров = Новый Массив;
	Пока ВыборкаТовары.Следующий() Цикл
		СтрокиТоваров.Добавить(Новый Структура("НоменклатураУИ, Номенклатура, ХарактеристикаУИ, Характеристика, Количество, Цена",
			Строка(ВыборкаТовары.Номенклатура.УникальныйИдентификатор()),
			Строка(ВыборкаТовары.Номенклатура),
			?(ВыборкаТовары.Характеристика = Неопределено, "", Строка(ВыборкаТовары.Характеристика.УникальныйИдентификатор())),
			?(ВыборкаТовары.Характеристика = Неопределено, "", Строка(ВыборкаТовары.Характеристика)),
			ВыборкаТовары.Количество,
			ВыборкаТовары.Цена));
	КонецЦикла;

	Шапка = Результаты[0].Выбрать();
	Шапка.Следующий();

	ДанныеОтчета.Добавить(Новый Структура("Склад, СуммаДокумента, Номер, Дата, Товары",
		Строка(Шапка.СкладПродажи),
		Шапка.СуммаДокумента,
		Строка(Шапка.Номер),
		Строка(Шапка.Дата),
		СтрокиТоваров));

	Возврат ДанныеОтчета;

КонецФункции

#КонецОбласти
