КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СоздатьВыемкуЗавершение(Сумма, ОтчетОРозничныхПродажах) Экспорт

	Если Не ЗначениеЗаполнено(Сумма) Тогда
		Возврат;
	КонецЕсли;

	СоздатьВыемкуНаСервере(ОтчетОРозничныхПродажах, Сумма);

КонецПроцедуры

&НаСервере
Процедура СоздатьВыемкуНаСервере(Знач ОтчетОРозничныхПродажах, Знач Сумма)

	Документы.ТБК_ВедомостьОПродажахЗаДень.СоздатьВыемкуПоОтчету(ОтчетОРозничныхПродажах, Сумма);
	ЗаполнитьПоДаннымКассы();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВнесенияДанныхПоВыручке(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ДанныеПоВыручке.Очистить();
	ДобавитьДанныеПоВыручке("Наличные", Результат.НаличныйZ, Результат.НаличныйФакт);
	ДобавитьДанныеПоВыручке("Безналичные", Результат.БезНаличныйZ, Результат.БезНаличныйФакт);
	Объект.ТерминальнаяСверкаНеВышла = Результат.ТерминальнаяСверкаНеВышла;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДанныеПоВыручке(ТипДС, ZОтчет, Фактически)

	НоваяСтрока = Объект.ДанныеПоВыручке.Добавить();
	НоваяСтрока.ТипДС = ТипДС;
	НоваяСтрока.ZОтчет = ZОтчет;
	НоваяСтрока.Фактически = Фактически;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымКассы()

	Если Не ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Укажите кассу ККМ.'"), , "КассаККМ", "Объект");
		Возврат;
	КонецЕсли;

	Ведомость = РеквизитФормыВЗначение("Объект");
	Документы.ТБК_ВедомостьОПродажахЗаДень.ЗаполнитьПоДаннымКассы(Ведомость);
	ЗначениеВРеквизитФормы(Ведомость, "Объект");

	РассчитатьНаличныеКСдаче(Объект);
	ОбновитьПоказателиФормы();
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКассуПоРабочемуМесту()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК КассаККМ,
	|	КассыККМ.Магазин КАК Магазин,
	|	Магазины.СкладПродажи КАК Склад
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Магазины КАК Магазины
	|		ПО (Магазины.Ссылка = КассыККМ.Магазин)
	|ГДЕ
	|	КассыККМ.РабочееМесто = &РабочееМесто
	|	И НЕ КассыККМ.ПометкаУдаления");
	Запрос.УстановитьПараметр("РабочееМесто", МенеджерОборудованияВызовСервера.РабочееМестоКлиента());
	КассыРабочегоМеста = Запрос.Выполнить().Выгрузить();

	// Если касс на рабочем месте несколько, кассу ККМ не угадываем: ее передает РМК или выбирает кассир.
	Если КассыРабочегоМеста.Количество() > 0 Тогда
		ЗаполняемыеСвойства = ?(КассыРабочегоМеста.Количество() = 1, "КассаККМ, Магазин, Склад", "Магазин, Склад");
		ЗаполнитьЗначенияСвойств(Объект, КассыРабочегоМеста[0], ЗаполняемыеСвойства);
	КонецЕсли;

	// РМК после закрытия смены передает кассу, смену которой закрыли.
	КассаИзПараметров = Неопределено;
	Если Параметры.Свойство("КассаККМ", КассаИзПараметров) И ЗначениеЗаполнено(КассаИзПараметров) Тогда
		Объект.КассаККМ = КассаИзПараметров;
		ДанныеКассы = КассыРабочегоМеста.Найти(КассаИзПараметров, "КассаККМ");
		Если ДанныеКассы <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Объект, ДанныеКассы, "Магазин, Склад");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПоставщиков()

	// Поставщики, которым платят из кассы (из старой Розницы; ЛК Андрей: Корунд заменили на Стоун).
	НаименованияПоставщиков = Новый Массив;
	НаименованияПоставщиков.Добавить("СТОУН , ООО");
	НаименованияПоставщиков.Добавить("СНС Северо-Запад ООО");

	Поставщики = Новый Массив;
	Для Каждого Наименование Из НаименованияПоставщиков Цикл
		Поставщик = Справочники.Контрагенты.НайтиПоНаименованию(Наименование);
		Если ЗначениеЗаполнено(Поставщик) Тогда
			Поставщики.Добавить(Поставщик);
		КонецЕсли;
	КонецЦикла;

	Элементы.ОплатаПоставщикуКонтрагент.СписокВыбора.ЗагрузитьЗначения(Поставщики);

КонецПроцедуры

// Автосохранение: записывает и проводит ведомость без вопросов пользователю. Причины отказа
// проверки уже сообщены пользователю, подробности ошибки пишутся в журнал регистрации.
&НаСервере
Процедура ЗаписатьНаСервере()

	Попытка
		Записать(Новый Структура("РежимЗаписи, Автосохранение", РежимЗаписиДокумента.Проведение, Истина));
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
		ИмяСобытия = НСтр("ru = 'ТБК.Ведомость о продажах за день'", ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ТБК_ВедомостьОПродажахЗаДень, Объект.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОшибки));
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ведомость не сохранена: %1'"), КраткоеПредставлениеОшибки(ИнформацияОшибки));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказателиФормы()

	СуммаВыемки = Объект.ВыемкаДенежныхСредств.Итог("Сумма");
	Элементы.ПродавцыПодробно.Заголовок = ЗаголовокПродавцов(Объект.Продавцы);

КонецПроцедуры

// Наличные к сдаче: наличная выручка и неучтенка за вычетом возвратов наличными,
// расходов отдела и зарплаты продавца.
&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьНаличныеКСдаче(ДанныеВедомости)

	ДанныеВедомости.НаличныеКСдаче = ДанныеВедомости.ОплатаНаличными
		+ ДанныеВедомости.ВедомостьПродажНеУчтено
		- ДанныеВедомости.ВозвратОтПокупателяНал
		- ДанныеВедомости.РасходыОтдела
		- ДанныеВедомости.ЗП_Продавца;

КонецПроцедуры

// Заголовок кнопки «Продавцы»: основной и второй продавец смены.
&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокПродавцов(Знач Продавцы)

	ТипОсновной = ПредопределенноеЗначение("Перечисление.ТБКТипыПродавцов.ОсновнойПродавец");
	ТипВторой = ПредопределенноеЗначение("Перечисление.ТБКТипыПродавцов.ВторойПродавец");

	ОсновнойПродавец = "";
	ВторойПродавец = "";
	Для Каждого СтрокаПродавца Из Продавцы Цикл
		Если СтрокаПродавца.ТипПродавца = ТипОсновной Тогда
			ОсновнойПродавец = "(Основной) " + СтрокаПродавца.Продавец;
		КонецЕсли;
		Если СтрокаПродавца.ТипПродавца = ТипВторой Тогда
			ВторойПродавец = "(Второй) " + СтрокаПродавца.Продавец;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ОсновнойПродавец) И ЗначениеЗаполнено(ВторойПродавец) Тогда
		Возврат ОсновнойПродавец + Символы.ПС + ВторойПродавец;
	КонецЕсли;
	Возврат ОсновнойПродавец + ВторойПродавец;

КонецФункции

#КонецОбласти
