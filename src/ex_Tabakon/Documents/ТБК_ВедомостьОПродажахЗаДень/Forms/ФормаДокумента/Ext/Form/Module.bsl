#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьПоДаннымКассы();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВыемку(Команда)

	ТекущиеДанные = Элементы.ОтчетыОРозничныхПродажах.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СоздатьВыемкуЗавершение", ЭтотОбъект, ТекущиеДанные.ОтчетОРозничныхПродажах);
	ТипСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ПоказатьВводЗначения(Оповещение, 0, НСтр("ru = 'Сумма выемки'"), ТипСуммы);

КонецПроцедуры

&НаКлиенте
Процедура ВнестиДанныеПоВыручке(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОплатаНаличными", Объект.ОплатаНаличными);
	ПараметрыФормы.Вставить("ОплатаПоБанковскимКартам", Объект.ОплатаПоБанковскимКартам);
	ПараметрыФормы.Вставить("ТерминальнаяСверкаНеВышла", Объект.ТерминальнаяСверкаНеВышла);

	// Первая строка данных по выручке - наличные, вторая - безналичные (см. ПослеВнесенияДанныхПоВыручке).
	Если Объект.ДанныеПоВыручке.Количество() >= 2 Тогда
		ПараметрыФормы.Вставить("НаличныйZ", Объект.ДанныеПоВыручке[0].ZОтчет);
		ПараметрыФормы.Вставить("НаличныйФакт", Объект.ДанныеПоВыручке[0].Фактически);
		ПараметрыФормы.Вставить("БезНаличныйZ", Объект.ДанныеПоВыручке[1].ZОтчет);
		ПараметрыФормы.Вставить("БезНаличныйФакт", Объект.ДанныеПоВыручке[1].Фактически);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВнесенияДанныхПоВыручке", ЭтотОбъект);
	ОткрытьФорму("Документ.ТБК_ВедомостьОПродажахЗаДень.Форма.ФормаДанныеПоВыручке", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыемкаПодробно(Команда)
	Элементы.ВыемкаДенежныхСредств.Видимость = Не Элементы.ВыемкаДенежныхСредств.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура Купюры(Команда)
	Элементы.Группа_Купюры.Видимость = Не Элементы.Группа_Купюры.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ПродажиПодробно(Команда)
	Элементы.ОтчетыОРозничныхПродажах.Видимость = Не Элементы.ОтчетыОРозничныхПродажах.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ПродавцыПодробно(Команда)
