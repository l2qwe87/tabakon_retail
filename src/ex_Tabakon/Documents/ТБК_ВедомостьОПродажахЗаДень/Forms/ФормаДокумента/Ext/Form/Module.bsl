#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьКассуПоРабочемуМесту();
		ЗаполнитьПоДаннымКассы();
	КонецЕсли;

	ЗаполнитьСписокВыбораПоставщиков();

	// Вик 2024-10-21: с ноября 2024 тип продавца и признак замены не показываем.
	Элементы.ПродавцыПродавецНаЗамену.Видимость = Ложь;
	Элементы.ПродавцыТипПродавца.Видимость = Ложь;

	// Номера купюр правят только в день ведомости.
	Если ЗначениеЗаполнено(Объект.Дата) И НачалоДня(Объект.Дата) <> НачалоДня(ТекущаяДатаСеанса()) Тогда
		Элементы.Группа_Купюры.ТолькоПросмотр = Истина;
	КонецЕсли;

	ОбновитьПоказателиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Вик 2021-10-18: новую ведомость сохраняем сразу, чтобы данные смены не потерялись,
	// если кассир просто закроет окно.
	Если Объект.Ссылка.Пустая() Тогда
		ЗаписатьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	// Вик 2021-10-18: изменения в новой ведомости сохраняем без вопроса «Сохранить?».
	// Если записать не удалось, платформа сама спросит о несохраненных данных.
	// При завершении работы программы обращаться к серверу нельзя.
	Если Параметры.Ключ.Пустая() И Модифицированность И Не ЗавершениеРаботы Тогда
		ЗаписатьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Автосохранение (см. ЗаписатьНаСервере) не проверяет продавцов и отчеты - см. модуль объекта.
	Если ПараметрыЗаписи.Свойство("Автосохранение") Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("Автосохранение", Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// При записи ведомость могла дополнить тип продавца.
	Элементы.ПродавцыПодробно.Заголовок = ЗаголовокПродавцов(ТекущийОбъект.Продавцы);

КонецПроцедуры

#КонецОбласти

