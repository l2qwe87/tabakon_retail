#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пока сумма не введена, в ячейке стоит текст-подсказка; в расчете разницы такие ячейки не участвуют.
	ПодсказкаZОтчет = НСтр("ru = 'Внести с z-отчета'");
	ДобавитьСтроку(НСтр("ru = 'Наличные'"), ЗначениеПараметра("ОплатаНаличными", 0),
		ЗначениеПараметра("НаличныйZ", ПодсказкаZОтчет),
		ЗначениеПараметра("НаличныйФакт", НСтр("ru = 'Пересчитать кассу и внести'")));
	ДобавитьСтроку(НСтр("ru = 'Безналичные'"), ЗначениеПараметра("ОплатаПоБанковскимКартам", 0),
		ЗначениеПараметра("БезНаличныйZ", ПодсказкаZОтчет),
		ЗначениеПараметра("БезНаличныйФакт", НСтр("ru = 'Внести с терминальной сверки'")));

	ТерминальнаяСверкаНеВышла = ЗначениеПараметра("ТерминальнаяСверкаНеВышла", Ложь);

	ПересчитатьРазницу(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеПоВыручке

&НаКлиенте
Процедура ДанныеПоВыручкеПриИзменении(Элемент)
	ПересчитатьРазницу(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеZОтчетИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ОтброситьНечисловыеСимволыВКонце(Элемент, Текст, "ZОтчет");
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеФактическиИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ОтброситьНечисловыеСимволыВКонце(Элемент, Текст, "Фактически");
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеZОтчетОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ЗаписатьВведеннуюСумму(Текст, "ZОтчет");
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВыручкеФактическиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ЗаписатьВведеннуюСумму(Текст, "Фактически");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Результат читает ПослеВнесенияДанныхПоВыручке формы документа.
&НаКлиенте
Процедура ОК(Команда)

	Результат = Новый Структура;
	Результат.Вставить("НаличныйZ", ДанныеПоВыручке[0].ZОтчет);
	Результат.Вставить("БезНаличныйZ", ДанныеПоВыручке[1].ZОтчет);
	Результат.Вставить("НаличныйФакт", ДанныеПоВыручке[0].Фактически);
	Результат.Вставить("БезНаличныйФакт", ДанныеПоВыручке[1].Фактически);
	Результат.Вставить("ТерминальнаяСверкаНеВышла", ТерминальнаяСверкаНеВышла);
	Закрыть(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьСтроку(ТипДС, По1с, ZОтчет, Фактически)

	НоваяСтрока = ДанныеПоВыручке.Добавить();
	НоваяСтрока.ТипДС = ТипДС;
	НоваяСтрока.По1с = По1с;
	НоваяСтрока.ZОтчет = ZОтчет;
	НоваяСтрока.Фактически = Фактически;

КонецПроцедуры

&НаСервере
Функция ЗначениеПараметра(ИмяПараметра, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Если Параметры.Свойство(ИмяПараметра, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРазницу(Форма)

	ЕстьРазница = Ложь;
	Для Каждого СтрокаВыручки Из Форма.ДанныеПоВыручке Цикл
		СтрокаВыручки.РазницаZ = РазницаСВведеннойСуммой(СтрокаВыручки.По1с, СтрокаВыручки.ZОтчет);
		СтрокаВыручки.РазницаФакт = РазницаСВведеннойСуммой(СтрокаВыручки.По1с, СтрокаВыручки.Фактически);
		ЕстьРазница = ЕстьРазница Или СтрокаВыручки.РазницаZ <> 0 Или СтрокаВыручки.РазницаФакт <> 0;
	КонецЦикла;

	Форма.Элементы.Декорация1.Заголовок = ?(ЕстьРазница, НСтр("ru = 'Сообщить администратору о разнице'"), "");

КонецПроцедуры

// Разница между суммой по данным 1С и введенной. Пока в ячейке подсказка, а не сумма, разница нулевая.
&НаКлиентеНаСервереБезКонтекста
Функция РазницаСВведеннойСуммой(По1с, ВведенноеЗначение)

	Сумма = ВведеннаяСумма(ВведенноеЗначение);
	Возврат ?(Сумма = Неопределено, 0, По1с - Сумма);

КонецФункции

// Число из ячейки либо Неопределено, если в ячейке подсказка, а не сумма.
&НаКлиентеНаСервереБезКонтекста
Функция ВведеннаяСумма(ВведенноеЗначение)

	Если ТипЗнч(ВведенноеЗначение) = Тип("Число") Тогда
		Возврат ВведенноеЗначение;
	КонецЕсли;
	Если ТипЗнч(ВведенноеЗначение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Суммы, сохраненные раньше, записаны с разделителем групп и запятой: «1 500,00».
	ТекстСуммы = СтрЗаменить(СтрЗаменить(ВведенноеЗначение, Символы.НПП, ""), ",", ".");
	Возврат СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекстСуммы);

КонецФункции

// Пока кассир вводит сумму, отрезает с конца до пяти символов, кроме цифр и точки.
&НаКлиенте
Процедура ОтброситьНечисловыеСимволыВКонце(Элемент, Текст, ИмяКолонки)

	МаксимумОтрезаемыхСимволов = 5;

	Элемент.ЦветТекста = WebЦвета.Черный;
	ОтрезаноСимволов = 0;
	Пока ОтрезаноСимволов < МаксимумОтрезаемыхСимволов И Не ЭтоЦифраИлиТочка(Прав(Текст, 1)) Цикл
		Текст = Сред(Текст, 1, СтрДлина(Текст) - 1);
		Элементы.ДанныеПоВыручке.ТекущиеДанные[ИмяКолонки] = Текст;
		ОтрезаноСимволов = ОтрезаноСимволов + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЭтоЦифраИлиТочка(Символ)
	Возврат Символ <> "" И СтрНайти("0123456789.", Символ) > 0;
КонецФункции

// Сохраняет введенную сумму строкой с двумя знаками после точки; ноль - числом,
// нечисловой ввод - строкой «0». Разделитель групп не ставим: иначе сумму от 1000
// не прочитать обратно в число при расчете разницы.
&НаКлиенте
Процедура ЗаписатьВведеннуюСумму(Текст, ИмяКолонки)

	ТекущиеДанные = Элементы.ДанныеПоВыручке.ТекущиеДанные;
	Сумма = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Текст);
	Если Сумма = Неопределено Тогда
		ТекущиеДанные[ИмяКолонки] = "0";
	ИначеЕсли Сумма = 0 Тогда
		ТекущиеДанные[ИмяКолонки] = Сумма;
	Иначе
		ТекущиеДанные[ИмяКолонки] = Формат(Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
