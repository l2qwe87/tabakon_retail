#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Проверки и кассовые ордера живут здесь, а не в форме: так они срабатывают при любой записи
// (кнопкой, автосохранением из формы, из кода) и идут в одной транзакции с ведомостью.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Удаляемую и распроводимую ведомость не проверяем и ордера по ней не трогаем,
	// иначе неполную ведомость нельзя было бы пометить на удаление.
	ОбработатьКассовыеОрдера = Не ПометкаУдаления И РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения;
	ДополнительныеСвойства.Вставить("ОбработатьКассовыеОрдера", ОбработатьКассовыеОрдера);
	Если Не ОбработатьКассовыеОрдера Тогда
		Возврат;
	КонецЕсли;

	МенеджерВедомостей = Документы.ТБК_ВедомостьОПродажахЗаДень;
	МенеджерВедомостей.ЗаполнитьТипПродавцаПоУмолчанию(ЭтотОбъект);
	// Признак ставит форма документа при автосохранении (ПередЗаписьюНаСервере формы).
	ЭтоАвтосохранение = ДополнительныеСвойства.Свойство("Автосохранение");
	МенеджерВедомостей.ПроверитьПередЗаписью(ЭтотОбъект, Отказ, ЭтоАвтосохранение);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	МенеджерВедомостей.СинхронизироватьКассовыеОрдера(ЭтотОбъект);

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Или Не ДополнительныеСвойства.ОбработатьКассовыеОрдера Тогда
		Возврат;
	КонецЕсли;

	Документы.ТБК_ВедомостьОПродажахЗаДень.ПровестиСвязанныеКассовыеОрдера(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
