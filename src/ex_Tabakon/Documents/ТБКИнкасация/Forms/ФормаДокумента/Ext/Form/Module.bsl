	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ЗаписатьНаСервере();
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ПараметрыПечати	=	новый Структура;
	ПараметрыПечати.Вставить("Дата", Объект.Дата);
	ПараметрыПечати.Вставить("ДатаПоследнейИнкасации", Объект.ДатаПоследнейИнкасации);
	ПараметрыПечати.Вставить("Комментарий", Объект.Комментарий);
	ПараметрыПечати.Вставить("Продавец", Строка(Объект.Продавец));
	ПараметрыПечати.Вставить("СуммаКСдаче", Строка(Объект.СуммаКСдаче));
	ПараметрыПечати.Вставить("СуммаСдаваемыхНаличных", Строка(Объект.СуммаСдаваемыхНаличных));
	ПараметрыПечати.Вставить("Экспедитор", Строка(Объект.Экспедитор));

	
	
	Магазин 	=	ТБКПолучитьМагазинНаСервере();
	КодМагазин	=	ПолучитьКодМагазинаСервер(Магазин); ;
	КодМагазин	=	СокрЛП(СтрЗаменить(КодМагазин, Символы.ПС,"")); 

	ПараметрыПечати.Вставить("КодМагазин",	 КодМагазин);
	ПараметрыПечати.Вставить("Магазин",		 Строка(Магазин));

	НапечататьИнкассация(ПараметрыПечати);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Элементы.Печать.Доступность	=	Истина;
КонецПроцедуры


&НаСервереБезКонтекста
Функция  ТБКПолучитьМагазинНаСервере()
	НужныйМагазин	=	ОбщегоНазначения.ПолучитьМагазинИзООРП();
	Если не ЗначениеЗаполнено(НужныйМагазин) тогда
		//НужныйМагазин	=		ЗначениеНастроекПовтИсп.СкладПродажиПоУмолчанию();
		Запрос	=	Новый запрос("ВЫБРАТЬ
		      	 	             |	Магазины.Ссылка КАК Ссылка
		      	 	             |ИЗ
		      	 	             |	Справочник.Магазины КАК Магазины
		      	 	             |ГДЕ
		      	 	             |	НЕ Магазины.СкладУправляющейСистемы");
		Рез = Запрос.Выполнить().Выгрузить();
		Если Рез.Количество()>0 тогда
			Возврат рез[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НужныйМагазин;	
КонецФункции

&НаСервереБезКонтекста
Функция  ПолучитьКодМагазинаСервер(Магазин)
	Возврат Магазин.Код;
КонецФункции

 &НаСервереБезКонтекста
Функция ПолучитьТекстКупюрСервер(НачалоПериода)
	Запрос	=	Новый запрос("ВЫБРАТЬ
	|	ТБК_ВедомостьОПродажахЗаДень.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТБК_ВедомостьОПродажахЗаДень КАК ТБК_ВедомостьОПродажахЗаДень
	|ГДЕ
	|	НЕ ТБК_ВедомостьОПродажахЗаДень.ПометкаУдаления
	|	И ТБК_ВедомостьОПродажахЗаДень.Дата МЕЖДУ &ДатаНач И &ДатаКон"); 
	Запрос.УстановитьПараметр("ДатаНач", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(НачалоПериода));   
	
	Рез = Запрос.Выполнить().Выбрать(); 
	Текст5000	=	"";  
	Текст2000	=	"";
	
	
	Пока рез.Следующий() цикл
		
		Для каждого Строка из рез.Ссылка.Купюры5000 цикл  
			Если Текст5000 = "" тогда
				Текст5000 = СтрЗаменить(Строка(Строка.Номер),Символы.НПП,"");;
			иначе
				Текст5000	=	Текст5000 + ", "+СтрЗаменить(Строка(Строка.Номер),Символы.НПП,"");;	
			КонецЕсли;
		КонецЦикла;
		
		
		Для каждого Строка из рез.Ссылка.Купюры2000 цикл  
			Если Текст2000 = "" тогда
				Текст2000 = СтрЗаменить(Строка(Строка.Номер),Символы.НПП,"");;
			иначе
				Текст2000	=	Текст2000 + ", "+СтрЗаменить(Строка(Строка.Номер),Символы.НПП,"");;	
			КонецЕсли;
		КонецЦикла; 
		
		
		
	КонецЦикла; 
	
	СтруктураВозврата	=	Новый Структура;
	СтруктураВозврата.Вставить("Текст5000", Текст5000);	  
	СтруктураВозврата.Вставить("Текст2000", Текст2000);	
	
	Возврат СтруктураВозврата;
	
 КонецФункции
		
&НаКлиенте
Процедура НапечататьИнкассация(ПараметрыПечати) экспорт   
	
	Fptr = ПодключитьВнешнююКомпоненту("AddIn.Fptr10");
	Fptr = Новый COMобъект("AddIn.Fptr10");
	Fptr.open();

		
	Если не Fptr.isOpened() тогда
		МенеджерОборудованияКлиент.ПоменятьПараметры(Истина);
		
		Fptr = ПодключитьВнешнююКомпоненту("AddIn.Fptr10");
		Fptr = Новый COMобъект("AddIn.Fptr10");
		Fptr.open();
	КонецЕсли;    
	
	Если не Fptr.isOpened() тогда
		Сообщить("Ошибка печати!");
		Возврат;
	КонецЕсли;
	
	
	ШиринаЛенты = Fptr.getParamInt(Fptr.LIBFPTR_PARAM_RECEIPT_LINE_LENGTH);
	
	
	Fptr.beginNonfiscalDocument();
	
	
	
	Fptr.setParam(Fptr.LIBFPTR_PARAM_BARCODE, Строка(ПараметрыПечати.КодМагазин));
	Fptr.setParam(Fptr.LIBFPTR_PARAM_BARCODE_TYPE, Fptr.LIBFPTR_BT_QR);
	Fptr.setParam(Fptr.LIBFPTR_PARAM_SCALE, 5);
	Fptr.printBarcode();

	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			

	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, "Дата инкассации: " + Формат(ПараметрыПечати.Дата,"ДФ=dd.MM.yyyy"));
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, "Магазин: " + ПараметрыПечати.Магазин);
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, "Период сдачи: " + Формат(ПараметрыПечати.ДатаПоследнейИнкасации,"ДФ=dd.MM.yyyy")+" - " + Формат(ПараметрыПечати.Дата-24*60*60,"ДФ=dd.MM.yyyy")  );
	
	
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			

	ТБКНеФискальнаяПечать.ПечатьСтроки_Пробелы(Fptr, "СУММА: " + ПараметрыПечати.СуммаСдаваемыхНаличных, "", Истина, ШиринаЛенты);
	
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			

	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, "Продавец: " +  ПараметрыПечати.Продавец  );   
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, "Экспедитор: " +  ПараметрыПечати.Экспедитор  );   
	
	
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			

	КонецПериода	=	НачалоДня(ПараметрыПечати.Дата-24*60*60);
	НачалоПериода	=	НачалоДня(ПараметрыПечати.ДатаПоследнейИнкасации);
	
	Пока КонецПериода >= НачалоПериода цикл 
		СтруктураТекстКупюр = ПолучитьТекстКупюрСервер(НачалоПериода);  
		
		
		Если СтруктураТекстКупюр.Текст5000 <> "" тогда
			ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, Формат(НачалоПериода,"ДФ=dd.MM.yyyy")+" Купюры 5000: "+ СтруктураТекстКупюр.Текст5000 ); 
		КонецЕсли; 
		
		Если СтруктураТекстКупюр.Текст2000 <> "" тогда
			ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr, Формат(НачалоПериода,"ДФ=dd.MM.yyyy")+" Купюры 2000: "+ СтруктураТекстКупюр.Текст2000 ); 
		КонецЕсли;

		
		НачалоПериода = НачалоПериода + 24*60*60;
	КонецЦикла;
	
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			
	
	Если ЗначениеЗаполнено(Объект.Комментарий) тогда
		ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,"Комментарий: "+Объект.Комментарий);  
	КонецЕсли;
	
	
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			
	ТБКНеФискальнаяПечать.ПечатьСтроки(Fptr,""); 			

	//Конец
	Fptr.setParam(Fptr.LIBFPTR_PARAM_PRINT_FOOTER, false);
	Fptr.endNonfiscalDocument();
	Fptr.cut();
	
	Fptr.close();   
	МенеджерОборудованияКлиент.ПоменятьПараметры(Ложь);

	//	        
	
КонецПроцедуры
