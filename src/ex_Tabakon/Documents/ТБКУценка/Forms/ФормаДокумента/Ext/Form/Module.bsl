
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не РольДоступна("ПолныеПрава") тогда
		Элементы.флОтправленВУТ.Видимость	= Ложь;
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Объект.Магазин) тогда
		Объект.Магазин	=	ОбщегоНазначения.ПолучитьМагазинИзООРП();
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Параметры.Ключ.Пустая() тогда
		Объект.Сформирован					= 	Ложь;
		Объект.Ответственный				=	Неопределено;
	КонецЕсли;
	
	Если Объект.Сформирован тогда 
		ЭтаФорма.ТолькоПросмотр	=	Истина;  	
	КонецЕсли;  
	
	ИспользоватьПодключаемоеОборудование	= Истина;	
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	
	ОтветственныйБыл		=	Объект.Ответственный;
	Объект.Ответственный	=	Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Если Не Отказ И Не Объект.Сформирован Тогда
	//	Сообщить("Не забудьте проставить галочку Сформирован!");		
	//КонецЕсли; 
	
	Если Объект.флОтправленВУТ и Объект.ПометкаУдаления тогда
		Сообщить("Документ отправлен в офис. Удаление невозможно.");	
		Отказ = Истина;
	КонецЕсли;  
	
