&После("ПередЗаписью")
Процедура ТБКПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ ТОгда
		Если (СтатусЧекаККМ = Перечисления.СтатусыЧековККМ.Архивный
			И мЗакрытиеСмены) Тогда
			Отказ = Ложь;
		КонецЕсли;  
	КонецЕсли;
	
	//костыль
	Если НЕ Отказ тогда
		
		Для каждого Строка из Товары цикл
			Если НЕ ЗначениеЗаполнено(Строка.Продавец) тогда
				Строка.Продавец = Пользователи.ТекущийПользователь().ФизическоеЛицо;
			КонецЕсли;
		КонецЦикла;
		
		//2024-05-24 Проставляем продавцов 
		Попытка
			Если КоличествоОсновныхПродавцов = 0 Тогда
				//1 находим смену
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ТБКСменыСотрудников.КассоваяСмена КАК КассоваяСмена
				|ИЗ
				|	РегистрСведений.ТБКСменыСотрудников КАК ТБКСменыСотрудников
				|ГДЕ
				|	ТБКСменыСотрудников.КассоваяСмена.Статус = &Статус
				|	И ТБКСменыСотрудников.КассоваяСмена.КассаККМ = &КассаККМ
				|
				|УПОРЯДОЧИТЬ ПО
				|	ТБКСменыСотрудников.КассоваяСмена.Дата УБЫВ";
				
				Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыКассовойСмены.Открыта);
				Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
				
				Рез = Запрос.Выполнить().Выбрать();
				
				Если Рез.Следующий()  тогда
					//2 находим продавцов по смене
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ТБКСменыСотрудников.Продавец КАК Продавец,
					|	ТБКСменыСотрудников.ТипПродавца КАК ТипПродавца
					|ИЗ
					|	РегистрСведений.ТБКСменыСотрудников КАК ТБКСменыСотрудников
					|ГДЕ
					|	ТБКСменыСотрудников.КассоваяСмена = &КассоваяСмена";
					Запрос.УстановитьПараметр("КассоваяСмена", Рез.КассоваяСмена);
					Рез1 = запрос.Выполнить().Выбрать();
					КоличествоОсновныхПродавцов = 0;
					
					//3 получаем двух продавцов если есть и считаем количетсво основных
					Продавец1 = Неопределено;
					Продавец2 = Неопределено;
					
					Пока рез1.Следующий()  Цикл
						 
						Если Продавец <> Рез1.Продавец Тогда
							
							Если Продавец1 = Неопределено и Продавец1<>Рез1.Продавец Тогда
								Продавец1 = Рез1.Продавец; 
							иначе
							    Продавец2 = Рез1.Продавец;
							КонецЕсли;
							
						КонецЕсли; 
						
						Если Рез1.ТипПродавца = Перечисления.ТБКТипыПродавцов.ОсновнойПродавец Тогда
							КоличествоОсновныхПродавцов = КоличествоОсновныхПродавцов + 1;
						КонецЕсли; 
						
					КонецЦикла; 
					
					//проставляем в товары продавцов
					Для каждого Строка Из Товары Цикл
						Строка.Продавец1 = Продавец1;
						Строка.Продавец2 = Продавец2;
					КонецЦикла; 
					
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Если Комментарий = "Перепроведен автоматически2" тогда отказ = ложь; КонецЕсли; // удалить после проведения чеков за май 
	
	//Марк 2026-08-26
	ТБКОбработатьЗаменуТовараНаБК(Отказ);
	//КонецМарк
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ТБКПриЗаписи(Отказ)
	
	Если не Отказ тогда 
		Попытка
			//Вик 2024-04-25 //вернуть уценку при возврате
			Если ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ТБКУценка_Новая.Чек КАК Чек,
				|	ТБКУценка_Новая.Номенклатура КАК Номенклатура,
				|	ТБКУценка_Новая.Код КАК Код,
				|	ТБКУценка_Новая.ПроцентСкидки КАК ПроцентСкидки,
				|	ТБКУценка_Новая.ПричинаУценки КАК ПричинаУценки,
				|	ТБКУценка_Новая.флОтправленВУт КАК флОтправленВУт,
				|	ТБКУценка_Новая.СуммаСкидки КАК СуммаСкидки,
				|	ТБКУценка_Новая.Цена КАК Цена
				|ИЗ
				|	РегистрСведений.ТБКУценка_Новая КАК ТБКУценка_Новая
				|ГДЕ
				|	ТБКУценка_Новая.Чек = &Чек";
				Запрос.УстановитьПараметр("Чек", ЧекККМПродажа);
				Рез = Запрос.Выполнить().Выбрать();
				
				Пока Рез.Следующий() цикл
					Рег = РегистрыСведений.ТБКУценка_Новая.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Рег, Рез);
					рег.Чек = Ссылка;
					Рег.Записать();
				КонецЦикла;
			КонецЕсли;
			//  
			
			//Вик 2024-09-11
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТБКМаркиДляСписания.Чек КАК Чек
			|ИЗ
			|	РегистрСведений.ТБКМаркиДляСписания КАК ТБКМаркиДляСписания
			|ГДЕ
			|	ТБКМаркиДляСписания.Чек = &Чек
			|
			|СГРУППИРОВАТЬ ПО
			|	ТБКМаркиДляСписания.Чек";
			Запрос.УстановитьПараметр("Чек", ЧекККМПродажа);
			Рез = Запрос.Выполнить().Выбрать();
			
			Если Рез.Следующий() тогда
				Рег = РегистрыСведений.ТБКМаркиДляСписания.СоздатьНаборЗаписей();
				Рег.Отбор.Чек.Установить(Рез.Чек);
				Рег.Записать();
			КонецЕсли;
			//
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	//Марк 2026-08-28
	ТБКЗаписатьМаркиДляСписанияПоЗамене(Отказ);
	//КонецМарк
	
КонецПроцедуры

// Заменяет маркированный товар, на который дана скидка, на его БК-аналог.
//
// Вызывается из ТБКПередЗаписью: данные для ККТ собираются из записанного документа
// (Документы.ЧекККМ.ПодготовитьДанныеДляПробитияЧека читает его заново по ссылке),
// поэтому подмена доезжает и до печатной формы чека, и до ОФД.
//
// Снятые марки складываются в ДополнительныеСвойства, а пишутся в ТБКМаркиДляСписания
// уже в ПриЗаписи: Чек - измерение регистра, а у нового чека в ПередЗаписью
// Ссылка еще пустая.
//
Процедура ТБКОбработатьЗаменуТовараНаБК(Отказ)
	
	Если Отказ
		Или ВидОперации <> Перечисления.ВидыОперацийЧекККМ.Продажа
		Или АкцизныеМарки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВидыНоменклатурыДляЗамены = Новый Соответствие;
	ВидыНоменклатурыДляЗамены.Вставить("Табак (х)", Истина);
	ВидыНоменклатурыДляЗамены.Вставить("Табак",     Истина);
	ВидыНоменклатурыДляЗамены.Вставить("Напитки",   Истина);
	ВидыНоменклатурыДляЗамены.Вставить("Одежда",    Истина);
	
	КэшНоменклатурыБК = Новый Соответствие;
	МаркиДляСписания  = Новый Массив;
	
	Для Каждого Строка Из Товары Цикл
		
		Если Строка.СуммаРучнойСкидки = 0
			И Строка.СуммаАвтоматическойСкидки = 0
			И Строка.СуммаСкидкиОплатыБонусом = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиМарок = АкцизныеМарки.НайтиСтроки(Новый Структура("КлючСвязи", Строка.КлючСвязи));
		Если СтрокиМарок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидыНоменклатурыДляЗамены[Строка.Номенклатура.ВидНоменклатуры.Наименование] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураБК = КэшНоменклатурыБК[Строка.Номенклатура];
		Если НоменклатураБК = Неопределено Тогда
			НоменклатураБК = ОбщегоНазначенияВызовСервера.ПолучитьНоменклатураБК(Строка.Номенклатура);
			КэшНоменклатурыБК.Вставить(Строка.Номенклатура, НоменклатураБК);
		КонецЕсли;
		
		Если НоменклатураБК.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураИсходная   = Строка.Номенклатура;
		ХарактеристикаИсходная = Строка.Характеристика;
		
		Строка.Номенклатура                     = НоменклатураБК;
		Строка.Характеристика                   = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Строка.Штрихкод                         = ""; // иначе код маркировки уедет в тег 1162/1163
		Строка.МРЦ                              = 0;
		Строка.НеобходимостьВводаАкцизнойМарки  = Ложь;
		Строка.НеобходимостьВводаКодаМаркировки = Ложь;
		
		Для Каждого СтрокаМарки Из СтрокиМарок Цикл
			
			МаркиДляСписания.Добавить(
				ТБКДанныеМаркиДляСписания(СтрокаМарки, НоменклатураИсходная, ХарактеристикаИсходная));
			
			АкцизныеМарки.Удалить(СтрокаМарки);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МаркиДляСписания.Количество() > 0 Тогда
		ДополнительныеСвойства.Вставить("ТБКМаркиДляСписанияПоЗамене", МаркиДляСписания);
	КонецЕсли;
	
КонецПроцедуры

// Собирает данные снимаемой марки для регистра ТБКМаркиДляСписания.
// Номенклатура и характеристика - исходные, до замены на БК.
//
// Параметры:
//  СтрокаМарки    - ДокументТабличнаяЧастьСтрока.ЧекККМ.АкцизныеМарки - удаляемая строка
//  Номенклатура   - СправочникСсылка.Номенклатура - товар до замены
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика до замены
//
// Возвращаемое значение:
//  Структура - реквизиты записи регистра
//
Функция ТБКДанныеМаркиДляСписания(СтрокаМарки, Номенклатура, Характеристика)
	
	ЗначениеМарки = СтрокаМарки.ТБКОтсканированнаяМарка;
	
	Если Не ЗначениеЗаполнено(ЗначениеМарки) Тогда
		ЗначениеМарки = Строка(СтрокаМарки.КодАкцизнойМарки);
	КонецЕсли;
	
	// Правило то же, что в ТБКЗаписатьМаркуЗаменыВБуфер формы РМК.
	КоличествоВУпаковке = 1;
	Если СтрДлина(ЗначениеМарки) > 29 Тогда
		Попытка
			КоличествоВУпаковке = ОбщегоНазначенияВызовСервера.ПолучитьКоличествоВУпаковкеПоКуару(ЗначениеМарки);
		Исключение
			КоличествоВУпаковке = 1;
		КонецПопытки;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КоличествоВУпаковке) Тогда
		КоличествоВУпаковке = 1;
	КонецЕсли;
	
	ДанныеМарки = Новый Структура;
	ДанныеМарки.Вставить("Номенклатура",        Номенклатура);
	ДанныеМарки.Вставить("Харкатеристика",      Характеристика);
	ДанныеМарки.Вставить("Марка",               ЗначениеМарки);
	ДанныеМарки.Вставить("КлючСвязи",           СтрокаМарки.КлючСвязи);
	ДанныеМарки.Вставить("КоличествоВУпаковке", КоличествоВУпаковке);
	ДанныеМарки.Вставить("Причина",             НСтр("ru = 'Замена на БК: скидка на маркированный товар'"));
	
	Возврат ДанныеМарки;
	
КонецФункции

// Пишет в ТБКМаркиДляСписания марки, снятые при замене товара на БК.
// Ном продолжает нумерацию уже существующих по этому чеку записей.
//
Процедура ТБКЗаписатьМаркиДляСписанияПоЗамене(Отказ)
	
	МаркиДляСписания = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("ТБКМаркиДляСписанияПоЗамене", МаркиДляСписания) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Удалить("ТБКМаркиДляСписанияПоЗамене");
	
	Если Отказ
		Или МаркиДляСписания = Неопределено
		Или МаркиДляСписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ТБКМаркиДляСписания.Ном) КАК Ном
	|ИЗ
	|	РегистрСведений.ТБКМаркиДляСписания КАК ТБКМаркиДляСписания
	|ГДЕ
	|	ТБКМаркиДляСписания.Чек = &Чек";
	Запрос.УстановитьПараметр("Чек", Ссылка);
	
	Ном = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ном) Тогда
		Ном = Выборка.Ном;
	КонецЕсли;
	
	Для Каждого ДанныеМарки Из МаркиДляСписания Цикл
		
		Ном = Ном + 1;
		
		Рег = РегистрыСведений.ТБКМаркиДляСписания.СоздатьМенеджерЗаписи();
		Рег.Чек = Ссылка;
		Рег.Ном = Ном;
		ЗаполнитьЗначенияСвойств(Рег, ДанныеМарки);
		Рег.ОтправленВ_УТ = Ложь;
		Рег.Записать();
		
	КонецЦикла;
	
КонецПроцедуры
