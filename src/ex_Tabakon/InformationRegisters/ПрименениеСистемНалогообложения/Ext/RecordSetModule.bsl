
&После("ПриЗаписи")
Процедура ТБКПриЗаписи(Отказ, Замещение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТБК_Константы.ИмяКонстанты КАК ИмяКонстанты
	|ИЗ
	|	РегистрСведений.ТБК_Константы КАК ТБК_Константы
	|ГДЕ
	|	ТБК_Константы.ИмяКонстанты ПОДОБНО ""%КлишеИзмененоУспешно%""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияВызовСервера.Установить_ЗначениеКонстанты_Общая(Выборка.ИмяКонстанты, Ложь);	
	КонецЦикла;
	
КонецПроцедуры
